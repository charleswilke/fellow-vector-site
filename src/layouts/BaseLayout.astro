---
import CRTIntro from '../components/CRTIntro.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ButtonSparks from '../components/ButtonSparks.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fellow Vector',
  description = 'Hands-on AI tutoring, role-focused workshops, and speaking that help individuals and teams build skills, judgment, and agency.',
} = Astro.props;

const siteUrl = 'https://fellowvector.com';
const socialImageUrl = `${siteUrl}/og.jpg?v=print-edition-3`;
const socialImageAlt = 'The striped Fellow Vector wordmark on a cream header above a dark halftone panel. The panel reads “Learn by doing!” with “AI Tutoring & Workshops” and “With Charles Wilke” beside his illustrated self-portrait.';
const ogTitle = title === 'Fellow Vector' ? title : `${title} — Fellow Vector`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      name: 'Fellow Vector',
      url: siteUrl,
      description: 'Hands-on AI tutoring, role-focused workshops, and speaking that help individuals and teams build skills, judgment, and agency.',
      founder: {
        '@type': 'Person',
        '@id': 'https://charleswilke.com/#person',
        name: 'Charles Wilke',
        url: 'https://charleswilke.com/',
        jobTitle: 'AI Tutor, Designer & Speaker',
        sameAs: [
          'https://www.linkedin.com/in/charles-wilke/',
        ],
      },
      serviceType: ['AI Tutoring', 'Role-Focused Workshops', 'Speaking', 'Webinars'],
      areaServed: 'Worldwide',
    },
    {
      '@type': 'WebSite',
      name: 'Fellow Vector',
      url: siteUrl,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="W1JZcnOpn_jBjByPfxrLwD-MgmAeShBWGAORZowccgk" />
    <title>{ogTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Fellow Vector" />
    <meta property="og:title"       content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={socialImageUrl} />
    <meta property="og:image:type"  content="image/jpeg" />
    <meta property="og:image:alt"   content={socialImageAlt} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url"         content={canonicalUrl} />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={socialImageUrl} />
    <meta name="twitter:image:alt"   content={socialImageAlt} />

    <!-- Fonts (self-hosted) -->
    <link rel="preload" href="/fonts/share-tech-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/vt323-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=amber-bulb-1" />
    <link rel="icon" type="image/x-icon" sizes="48x48 32x32 16x16" href="/favicon.ico?v=amber-bulb-1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=amber-bulb-1" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Per-page head extras (preconnects, etc.) -->
    <slot name="head" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <CRTIntro />
    <Nav />
    <div class="crt-glass" aria-hidden="true"></div>

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <ButtonSparks />
  </body>
</html>

<style is:global>
  #main-content {
    position: relative;
    z-index: 1;
    padding-top: var(--nav-height);
  }
</style>
