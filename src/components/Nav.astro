---
import { getImage } from 'astro:assets';
import keycap from '../assets/nav-keycap.webp';

const navLinks = [
  { href: '/services', label: 'Learn' },
  { href: '/about',    label: 'About'    },
  { href: '/writing',  label: 'Writings'  },
  { href: '/book',     label: 'Book a Call' },
];

const { pathname } = Astro.url;
const keycapImage = await getImage({ src: keycap, width: 520, format: 'webp' });
---

<header id="site-nav" style={`--keycap-image: url("${keycapImage.src}")`}>
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="Fellow Vector home, AI tutoring and workshops">
      <span class="logo-wordmark">
        <span class="logo-bracket">[</span>
        <span class="logo-text">FELLOW VECTOR</span>
        <span class="logo-bracket">]</span>
      </span>
      <span class="logo-descriptor">AI Tutoring &amp; Workshops</span>
    </a>

    <div class="nav-board nav-board-desktop">
      <nav aria-label="Main navigation">
        <ul class="nav-links">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { active: pathname.startsWith(link.href) }]}
                aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
              >
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <details class="mobile-nav">
      <summary class="nav-toggle" aria-label="Navigation menu" aria-controls="mobile-navigation">
        <span class="nav-toggle-face" aria-hidden="true">
          <span class="nav-toggle-bars"><span></span><span></span><span></span></span>
          <span class="nav-toggle-label">MENU</span>
        </span>
        <span class="nav-toggle-light" aria-hidden="true"></span>
      </summary>
      <div class="nav-board nav-drawer" id="mobile-navigation">
        <nav aria-label="Main navigation">
          <ul class="nav-links">
            {navLinks.map((link, index) => (
              <li style={`--key-order: ${index}`}>
                <a
                  href={link.href}
                  class:list={['nav-link', { active: pathname.startsWith(link.href) }]}
                  aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
                >
                  <span>{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  #site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 8000;
    background: rgba(var(--bg-rgb), 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    gap: clamp(1rem, 3vw, 2rem);
    padding-top: 12px;
    padding-bottom: 16px;
  }

  /* Logo */
  .nav-logo {
    font-family: var(--font-crt);
    font-size: 1.7rem;
    letter-spacing: 0.08em;
    color: var(--fg);
    text-decoration: none;
    display: grid;
    grid-template-columns: max-content;
    gap: 0.35rem;
    line-height: 1;
    transition: color 0.2s;
    flex-shrink: 0;
  }

  .nav-logo:hover {
    color: var(--phosphor);
    text-shadow: var(--glow-phosphor);
  }

  .logo-bracket {
    color: var(--phosphor);
    opacity: 0.6;
  }

  .logo-wordmark {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .logo-descriptor {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-align: justify;
    text-align-last: justify;
    color: var(--fg-muted);
    text-shadow: none;
  }

  .logo-text {
    margin: 0 2px;
  }

  /* A compact moulded case seats four equally sized keys. */
  .nav-board {
    position: relative;
    flex: 0 1 418px;
    min-width: 0;
    padding: 3px 4px 6px;
    border: 1px solid #a08a67;
    border-top-color: #d3bf9a;
    border-bottom-color: #7b6243;
    border-radius: 6px 6px 5px 5px;
    background: linear-gradient(180deg,
      #ddc9a5 0%, #c7af88 7%, #b79c73 16%,
      #b79c73 78%, #a88b61 91%, #8f714c 100%);
    box-shadow:
      inset 1px 0 0 rgba(245, 227, 190, 0.35),
      inset -1px 0 0 rgba(81, 58, 34, 0.2),
      inset 0 1px 0 rgba(251, 236, 205, 0.6),
      inset 0 -1px 0 rgba(67, 45, 27, 0.35),
      0 2px 0 #655036, 0 3px 0 #493622,
      0 5px 8px rgba(0, 0, 0, 0.3);
  }

  .nav-board::after {
    content: '';
    position: absolute;
    left: 5px;
    right: 5px;
    bottom: 2px;
    height: 1px;
    background: rgba(82, 59, 35, 0.3);
    box-shadow: 0 1px 0 rgba(241, 218, 174, 0.22);
    pointer-events: none;
  }

  .nav-links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: #1b130c;
    border-radius: 2px;
    box-shadow: 0 0 0 1px #5a442b,
      0 1px 0 1px rgba(235, 212, 170, 0.38),
      0 -1px 1px 1px rgba(57, 38, 21, 0.45);
  }

  .nav-links li { min-width: 0; }

  .nav-link {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 46px;
    padding: 0 7px 4px;
    border-radius: 2px;
    background: linear-gradient(135deg, #8b704e 0%, #62482e 35%, #392619 100%);
    box-shadow: inset 1px 1px 0 rgba(241, 219, 181, 0.24),
      inset -1px -1px 0 rgba(0, 0, 0, 0.5);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    color: var(--fg);
    touch-action: manipulation;
    transition: color 0.1s ease;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 3px 3px 6px;
    z-index: 0;
    border-radius: 2px;
    background:
      linear-gradient(170deg, rgba(236, 206, 156, 0.12), transparent 45%, rgba(0, 0, 0, 0.12)),
      var(--keycap-image) 50% 25% / 125% 205% no-repeat;
    box-shadow: inset 0 1px 0 rgba(239, 214, 174, 0.22),
      inset 1px 0 0 rgba(239, 214, 174, 0.12), 0 2px 2px rgba(0, 0, 0, 0.4);
    transform: translateY(0);
    transition: transform 0.15s cubic-bezier(0.2, 1.55, 0.4, 1), box-shadow 0.12s ease;
  }

  .nav-link span {
    position: relative;
    z-index: 1;
    transform: translateY(0);
    transition: transform 0.15s cubic-bezier(0.2, 1.55, 0.4, 1);
  }

  .nav-link:hover,
  .nav-link.active { color: var(--phosphor); }

  .nav-link.active { text-shadow: 0 0 6px rgba(255, 189, 89, 0.4); }

  .nav-link:is(:active, [data-depressed])::before {
    transform: translateY(3px);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.3),
      inset 1px 0 0 rgba(239, 214, 174, 0.08), 0 0 1px rgba(0, 0, 0, 0.2);
    transition-duration: 0.035s;
    transition-timing-function: ease-out;
  }

  .nav-link:is(:active, [data-depressed]) span {
    transform: translateY(3px);
    transition-duration: 0.035s;
    transition-timing-function: ease-out;
  }

  .nav-link:focus-visible {
    z-index: 2;
    outline: 2px solid var(--phosphor);
    outline-offset: 1px;
  }

  .mobile-nav { display: none; }

  @media (max-width: 760px) {
    #site-nav {
      backdrop-filter: none;
      background: rgba(var(--bg-rgb), 0.97);
    }
  }

  @media (max-width: 640px) {
    .nav-board-desktop { display: none; }

    .logo-descriptor {
      justify-self: center;
      width: auto;
      letter-spacing: 0.03em;
      text-align: left;
      text-align-last: auto;
    }

    .mobile-nav {
      display: block;
      flex: 0 0 56px;
    }

    .nav-toggle {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      border: 1px solid #a08a67;
      border-top-color: #d3bf9a;
      border-bottom-color: #7b6243;
      border-radius: 5px;
      background: linear-gradient(180deg, #ddc9a5, #b79c73 20%, #a88b61 90%, #8f714c);
      box-shadow: inset 1px 1px 0 #e1cfac, inset -1px -1px 0 #7b6243,
        0 2px 0 #655036, 0 3px 0 #493622, 0 5px 8px rgba(0, 0, 0, 0.3);
      list-style: none;
      cursor: pointer;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }

    .nav-toggle::-webkit-details-marker { display: none; }

    .nav-toggle::before {
      content: '';
      position: absolute;
      inset: 4px 4px 7px;
      border: 1px solid #513822;
      border-radius: 2px;
      background: linear-gradient(170deg, rgba(236, 206, 156, 0.1), rgba(0, 0, 0, 0.12)),
        var(--keycap-image) center / 250% 200% no-repeat, #62482e;
      box-shadow: inset 1px 1px 0 rgba(239, 214, 174, 0.3), 0 3px 2px rgba(0, 0, 0, 0.5);
      transition: transform 0.15s cubic-bezier(0.2, 1.55, 0.4, 1), box-shadow 0.15s;
    }

    .nav-toggle-face {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      padding-bottom: 4px;
      color: var(--fg);
      transition: transform 0.15s cubic-bezier(0.2, 1.55, 0.4, 1);
    }

    .nav-toggle-bars {
      position: relative;
      display: block;
      width: 18px;
      height: 12px;
    }

    .nav-toggle-bars span {
      position: absolute;
      left: 0;
      width: 18px;
      height: 2px;
      border-radius: 1px;
      background: currentColor;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.6);
      transition: transform 0.22s ease, opacity 0.15s ease;
    }

    .nav-toggle-bars span:nth-child(1) { top: 0; }
    .nav-toggle-bars span:nth-child(2) { top: 5px; }
    .nav-toggle-bars span:nth-child(3) { top: 10px; }

    .nav-toggle-label {
      font-family: var(--font-mono);
      font-size: 0.5rem;
      line-height: 1;
      letter-spacing: 0.1em;
    }

    .nav-toggle-light {
      position: absolute;
      top: 9px;
      right: 9px;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: #654c29;
      box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.6);
    }

    .mobile-nav[open] .nav-toggle-light {
      background: var(--phosphor);
      box-shadow: 0 0 5px rgba(255, 189, 89, 0.6);
    }

    .mobile-nav[open] .nav-toggle-face { color: var(--phosphor); }
    .mobile-nav[open] .nav-toggle-bars span:nth-child(1) { transform: translateY(5px) rotate(45deg); }
    .mobile-nav[open] .nav-toggle-bars span:nth-child(2) { opacity: 0; }
    .mobile-nav[open] .nav-toggle-bars span:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

    .nav-toggle:is(:active, [data-depressed])::before,
    .nav-toggle:is(:active, [data-depressed]) .nav-toggle-face {
      transform: translateY(3px);
      transition-duration: 0.035s;
      transition-timing-function: ease-out;
    }
    .nav-toggle:is(:active, [data-depressed])::before {
      box-shadow: inset 1px 1px 2px rgba(0, 0, 0, 0.4);
    }

    .nav-toggle:focus-visible {
      outline: 2px solid var(--phosphor);
      outline-offset: 4px;
    }

    .nav-drawer {
      position: absolute;
      top: calc(100% + 8px);
      right: clamp(1.25rem, 3vw, var(--sp-lg));
      width: min(418px, calc(100% - 2.5rem));
      transform-origin: top right;
    }

    .nav-drawer .nav-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .nav-drawer .nav-link { height: 60px; font-size: 0.85rem; }

    .mobile-nav[open] .nav-drawer {
      animation: drawer-open 0.35s cubic-bezier(0.2, 0.8, 0.3, 1) both;
    }

    .mobile-nav[open] .nav-links li {
      animation: key-rollout 0.3s cubic-bezier(0.2, 0.85, 0.3, 1) both;
      animation-delay: calc(0.06s + var(--key-order) * 0.045s);
    }
  }

  @keyframes drawer-open {
    from { opacity: 0; transform: perspective(600px) translateY(-12px) rotateX(-12deg); }
    to { opacity: 1; transform: perspective(600px) translateY(0) rotateX(0); }
  }

  @keyframes key-rollout {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav[open] .nav-drawer,
    .mobile-nav[open] .nav-links li { animation: none; }

    .nav-toggle::before,
    .nav-toggle-face,
    .nav-toggle-bars span,
    .nav-link::before,
    .nav-link span { transform: none !important; transition: none; }

    .mobile-nav[open] .nav-toggle-bars span:nth-child(1) { transform: translateY(5px) rotate(45deg) !important; }
    .mobile-nav[open] .nav-toggle-bars span:nth-child(3) { transform: translateY(-5px) rotate(-45deg) !important; }
  }
</style>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  const menuToggle = mobileMenu?.querySelector<HTMLElement>('summary');
  let menuNavigationTimer: number | undefined;

  function closeMobileMenu(restoreFocus = false) {
    window.clearTimeout(menuNavigationTimer);
    menuNavigationTimer = undefined;
    if (!mobileMenu?.open) return;
    mobileMenu.open = false;
    if (restoreFocus) menuToggle?.focus();
  }

  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node && !mobileMenu?.contains(event.target)) closeMobileMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu?.open) {
      event.preventDefault();
      closeMobileMenu(true);
    }
  });

  mobileMenu?.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !mobileMenu.contains(event.relatedTarget)) closeMobileMenu();
  });

  mobileMenu?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!mobileMenu.open || event.defaultPrevented || event.button !== 0 ||
          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
          (link.target && link.target !== '_self') || link.hasAttribute('download')) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        closeMobileMenu();
        return;
      }

      event.preventDefault();
      window.clearTimeout(menuNavigationTimer);
      menuNavigationTimer = window.setTimeout(() => {
        closeMobileMenu();
        window.location.assign(link.href);
      }, 200);
    });
  });

  window.matchMedia('(max-width: 640px)').addEventListener('change', () => closeMobileMenu());

  document.querySelectorAll<HTMLElement>('#site-nav .nav-link, #site-nav .nav-toggle').forEach((key) => {
    let pressedAt = 0;
    let releaseTimer: number | undefined;

    function press() {
      window.clearTimeout(releaseTimer);
      pressedAt = performance.now();
      key.setAttribute('data-depressed', '');
    }

    function release(immediate = false) {
      window.clearTimeout(releaseTimer);
      releaseTimer = window.setTimeout(
        () => key.removeAttribute('data-depressed'),
        immediate ? 0 : Math.max(0, 85 - (performance.now() - pressedAt)),
      );
    }

    key.addEventListener('pointerdown', (event) => {
      if (event.button === 0 && event.isPrimary) press();
    });
    key.addEventListener('pointerup', () => release());
    key.addEventListener('pointerleave', () => release());
    key.addEventListener('pointercancel', () => release(true));
    key.addEventListener('blur', () => release(true));
    key.addEventListener('keydown', (event) => {
      if ((event.key === 'Enter' || (key.matches('summary') && event.key === ' ')) && !event.repeat) press();
    });
    key.addEventListener('keyup', (event) => {
      if (event.key === 'Enter' || (key.matches('summary') && event.key === ' ')) release();
    });
  });
</script>
