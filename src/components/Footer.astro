---
import { Image } from 'astro:assets';
import bulb from '../assets/cw-bulb-amber.webp';
import { navLinks } from '../data/nav-links';

const year = new Date().getFullYear();
---

<footer id="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">FELLOW VECTOR</span>
      <p class="footer-tagline text-muted">
        AI Tutoring &middot; Workshops &middot; Speaking
      </p>
    </div>

    <div class="footer-navigation">
      <nav class="footer-nav" aria-label="Footer navigation">
        {navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
      <Image src={bulb} class="footer-bulb" alt="" widths={[128, 256, 384]} sizes="128px" loading="lazy" />
    </div>

    <div class="footer-meta">
      <span class="text-muted">&copy; {year} Fellow Vector</span>
      <a href="mailto:cwilke@fellowvector.com" class="footer-signal text-phosphor" data-text="// signal active">// signal active</a>
    </div>
  </div>
</footer>

<style>
  #site-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border);
    padding: clamp(2rem, 4vw, 3rem) 0;
    overflow: hidden;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--layout-gap);
  }

  .footer-logo {
    font-family: var(--font-crt);
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    color: var(--fg);
    display: block;
    margin-bottom: var(--sp-xs);
  }

  .footer-tagline {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    max-width: none;
  }

  .footer-navigation {
    display: flex;
    align-items: center;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .footer-nav a {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .footer-nav a:hover {
    color: var(--phosphor);
  }

  .footer-bulb {
    width: 4.75rem;
    height: 8rem;
    object-fit: cover;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-xs);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  /* Runs on every page forever, so it animates opacity only. The glow sits on a
     pseudo-element that fades in, instead of repainting text-shadow each frame. */
  .footer-signal {
    position: relative;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    opacity: 0.5;
    animation: pulse 3s ease-in-out infinite;
  }

  .footer-signal::after {
    content: attr(data-text) / "";
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    color: transparent;
    text-shadow: var(--glow-phosphor);
    opacity: 0;
    animation: pulse-glow 3s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50%      { opacity: 1; }
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0; }
    50%      { opacity: 1; }
  }

  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--sp-lg);
    }
  }
</style>
