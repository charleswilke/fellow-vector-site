---
import '../styles/feed.css';

// Props:
//   limit   — number of posts to show (default 3)
//   variant — "compact" (sidebar) | "full" (writings page)
const { limit = 3, variant = 'compact' } = Astro.props;
---

<div class="substack-feed" data-limit={limit} data-variant={variant} aria-label="Recent essays from Exploring L.ai.bor">
  <div class="feed-loading" role="status">
    <span>Loading the latest essays<span class="feed-cursor" aria-hidden="true">_</span></span>
  </div>
  <ul class="feed-list" hidden></ul>
  <div class="feed-error" role="status" hidden>
    <p>The latest essays couldn’t load.</p>
    <a href="https://charleswilke.substack.com/archive?sort=new" target="_blank" rel="noopener">Browse the archive ↗</a>
  </div>
</div>

<script>
  function esc(str) {
    const el = document.createElement('span');
    el.textContent = str;
    return el.innerHTML;
  }

  function escAttr(str) {
    return str.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  async function loadFeed(container) {
    const limit = parseInt(container.dataset.limit) || 3;
    const variant = container.dataset.variant || 'compact';
    const loading = container.querySelector('.feed-loading');
    const list = container.querySelector('.feed-list');
    const error = container.querySelector('.feed-error');

    try {
      // /api/feed returns pre-trimmed JSON: { items: [{ title, link, date, excerpt, image }] }
      const res = await fetch('/api/feed');
      if (!res.ok) throw new Error('Feed fetch failed');
      const data = await res.json();
      const items = (Array.isArray(data.items) ? data.items : []).slice(0, limit);

      if (!items.length) throw new Error('No items');

      const excerptLength = variant === 'full' ? 280 : 160;

      list.innerHTML = items.map((item) => {
        const title = esc(item.title ?? '');
        const rawLink = item.link ?? '';
        const link = escAttr(/^https?:\/\//.test(rawLink) ? rawLink : '#');
        const rawImageUrl = item.image ?? '';
        const imageUrl = escAttr(/^https:\/\//.test(rawImageUrl) ? rawImageUrl : '');

        const parsedDate = new Date(item.date ?? '');
        const date = Number.isNaN(parsedDate.getTime()) ? '' : esc(parsedDate.toLocaleDateString('en-US', {
          year: 'numeric', month: 'short', day: 'numeric',
        }));
        const dateHtml = date ? `<time class="feed-date" datetime="${parsedDate.toISOString()}">${date}</time>` : '';

        const excerpt = esc((item.excerpt ?? '').slice(0, excerptLength));

        if (variant === 'full') {
          const imageHtml = imageUrl ? `
            <div class="feed-thumb">
              <img src="${imageUrl}" alt="" class="feed-thumb-img" loading="lazy" decoding="async" width="640" height="360" />
            </div>
          ` : '<div class="feed-thumb feed-thumb--empty" aria-hidden="true"><span>Exploring<br />L.ai.bor_</span></div>';

          return `
            <li class="feed-item feed-item--full">
              <a href="${link}" target="_blank" rel="noopener" class="feed-link">
                ${imageHtml}
                <div class="feed-body">
                  <div class="feed-meta"><span class="feed-publication">Exploring L.ai.bor</span>${dateHtml}</div>
                  <h2 class="feed-title">${title}</h2>
                  ${excerpt ? `<p class="feed-excerpt">${excerpt}</p>` : ''}
                  <span class="feed-read">Read essay <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </li>
          `;
        }

        return `
          <li class="feed-item">
            <a href="${link}" target="_blank" rel="noopener" class="feed-link">
              <div class="feed-meta">
                ${dateHtml}
              </div>
              <div class="feed-title">${title}</div>
              ${excerpt ? `<p class="feed-excerpt">${excerpt}</p>` : ''}
            </a>
          </li>
        `;
      }).join('');

      loading.hidden = true;
      list.hidden = false;
    } catch (e) {
      loading.hidden = true;
      error.hidden = false;
    }
  }

  document.querySelectorAll('.substack-feed').forEach(loadFeed);
</script>
