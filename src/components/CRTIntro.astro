---
// First-visit signal: a quiet accent in the navigation, with the page usable throughout.
---

<style is:global>
  #site-nav[data-signal-intro]::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--phosphor), transparent);
    transform-origin: left;
    pointer-events: none;
    animation: signal-sweep 2.2s ease-out both;
  }

  #site-nav[data-signal-intro] .nav-logo {
    position: relative;
  }

  #site-nav[data-signal-intro] .logo-text {
    animation: signal-warmup 2.2s ease-out both;
  }

  #site-nav[data-signal-intro] .nav-logo::after {
    content: '// signal acquired';
    position: absolute;
    top: calc(100% - 2px);
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    line-height: 1;
    letter-spacing: 0.1em;
    color: var(--phosphor);
    white-space: nowrap;
    pointer-events: none;
    animation: signal-note 2.2s ease-out both;
  }

  @keyframes signal-sweep {
    0% { transform: scaleX(0); opacity: 0; }
    20% { opacity: 0.45; }
    65% { transform: scaleX(1); opacity: 0.3; }
    100% { transform: scaleX(1); opacity: 0; }
  }

  @keyframes signal-warmup {
    0%, 100% { text-shadow: none; }
    35% { text-shadow: var(--glow-green); }
  }

  @keyframes signal-note {
    0%, 100% { opacity: 0; }
    25%, 65% { opacity: 0.65; }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-nav[data-signal-intro]::after,
    #site-nav[data-signal-intro] .nav-logo::after {
      display: none;
    }

    #site-nav[data-signal-intro] .logo-text {
      animation: none;
    }
  }
</style>

<script>
  (() => {
    const nav = document.getElementById('site-nav');
    if (!nav || location.pathname.startsWith('/book')) return;

    const seenKey = 'fv_intro_seen';
    const expiry = Date.now() + 30 * 24 * 60 * 60 * 1000;
    const forced = new URLSearchParams(location.search).has('intro');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seen = false;

    // Storage can be unavailable in private or restricted browsing. The page still works.
    try {
      seen = Date.now() < Number(localStorage.getItem(seenKey));
      if (reducedMotion || forced || !seen) {
        localStorage.setItem(seenKey, String(expiry));
      }
    } catch {
      // A brief decorative accent can run without persistent storage.
    }

    if (reducedMotion || (seen && !forced)) return;

    nav.setAttribute('data-signal-intro', '');
    window.setTimeout(() => nav.removeAttribute('data-signal-intro'), 2300);
  })();
</script>
