---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  class?: string;
  label: string;
  title: string;
  image: ImageMetadata;
  imageOpacity?: number;
  imagePosition?: string;
  preserveImageColor?: boolean;
  wideFraming?: boolean;
  showCursor?: boolean;
  compact?: boolean;
  serifTitle?: boolean;
}

const {
  class: className,
  label,
  title,
  image,
  imageOpacity = 0.5,
  imagePosition = 'center',
  preserveImageColor = false,
  wideFraming = false,
  showCursor = false,
  compact = false,
  serifTitle = false,
} = Astro.props;
---

<section class:list={['page-hero', className, { compact }]}>
  <div class="page-hero-bg" aria-hidden="true">
    <!-- Sub-page LCP candidate: eager + high priority, responsive widths for full-bleed -->
    <Image
      src={image}
      alt=""
      class:list={['page-hero-splash', {
        'preserve-image-color': preserveImageColor,
        'wide-framing': wideFraming,
      }]}
      widths={[480, 800, 1200, 1600]}
      sizes={wideFraming ? '(max-width: 62rem) 100vw, 62rem' : '100vw'}
      loading="eager"
      fetchpriority="high"
      style={`opacity: ${imageOpacity}; object-position: ${imagePosition}`}
    />
  </div>
  <div class="container page-hero-inner">
    <div class="label">{label}</div>
    <h1 class:list={{ 'serif-title': serifTitle }} aria-label={Astro.slots.has('title') ? title : undefined}><slot name="title">{title}</slot>{showCursor && <span class="hero-cursor" aria-hidden="true">_</span>}</h1>
    <slot />
  </div>
</section>

<style>
  @font-face {
    font-family: 'Besley';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('/fonts/besley-semibold-latin.woff2') format('woff2');
  }

  .page-hero {
    position: relative;
    border-bottom: 1px solid var(--border);
    padding: var(--section-space) 0;
    overflow: hidden;
  }

  .page-hero.compact { padding-block: clamp(1.5rem, 2.25vw, 2rem); }
  .compact .page-hero-inner :global(h1) { margin-block: 0; }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preserve-image-color { filter: none; }

  .wide-framing {
    display: block;
    width: min(100%, 62rem);
    margin-inline-start: auto;
    mask-image: linear-gradient(to right, transparent, #000 28%);
  }

  @media (max-width: 700px) {
    .wide-framing {
      height: min(100%, 80vw);
      mask-image: linear-gradient(to bottom, #000 64%, transparent);
    }
  }

  .page-hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      var(--page-hero-horizontal-fade, linear-gradient(to right,
        var(--bg) 22%,
        rgba(var(--bg-rgb), 0.65) 55%,
        rgba(var(--bg-rgb), 0.2) 100%
      )),
      linear-gradient(to top,
        var(--bg) 0%,
        transparent 35%
      );
  }

  .page-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .page-hero-inner :global(h1) {
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    margin-top: var(--sp-xs);
    margin-bottom: var(--sp-sm);
  }

  .page-hero-inner h1.serif-title {
    font-family: 'Besley', Georgia, serif;
    font-weight: 600;
    letter-spacing: 0;
  }

  @media (max-width: 350px) {
    .page-hero-inner :global(h1:has(.hero-cursor)) {
      font-size: clamp(2rem, 12.25vw, 2.5rem);
    }
  }

</style>
