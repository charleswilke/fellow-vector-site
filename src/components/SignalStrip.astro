---
interface Props {
  phrases: string[];
}

const { phrases } = Astro.props;
---

<div class="signal-strip" aria-hidden="true">
  <div class="signal-ticker">
    {Array.from({ length: 4 }, () => (
      <div class="signal-repeat">
        {phrases.map((phrase) => (
          <span class="signal-item">{phrase}<span class="sep">//</span></span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .signal-strip {
    overflow: hidden;
    border-block: 1px solid var(--border);
    padding: 0.6rem 0;
    background: var(--bg-surface);
  }

  .signal-ticker {
    display: flex;
    width: max-content;
    animation: ticker 22s linear infinite;
    white-space: nowrap;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--fg-muted);
  }

  .signal-repeat {
    --signal-gap: 1.25rem;
    display: flex;
    gap: var(--signal-gap);
    padding-inline-end: var(--signal-gap);
  }

  .signal-item {
    display: flex;
    gap: var(--signal-gap);
  }

  .sep {
    color: var(--amber);
  }

  @keyframes ticker {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-25%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-ticker { animation: none; }
  }
</style>
