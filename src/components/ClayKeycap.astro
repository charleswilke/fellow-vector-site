---
import { getImage } from 'astro:assets';
import keycap from '../assets/nav-keycap.webp';

interface Props {
  href?: string;
  id?: string;
}

const { href, id } = Astro.props;
const Tag = href ? 'a' : 'span';
const keycapImage = await getImage({ src: keycap, width: 520, format: 'webp' });
---

<Tag {href} {id} class="clay-feature-cta" style={`--keycap-image: url("${keycapImage.src}")`}>
  <span class="clay-feature-cta-label"><slot /></span>
</Tag>

<style>
  .clay-feature-cta {
    position: relative;
    isolation: isolate;
    display: inline-block;
    padding: 0.7rem 1rem 0.85rem;
    border-radius: 3px;
    background: linear-gradient(135deg, #8b704e 0%, #62482e 35%, #392619 100%);
    color: #fff2d9;
    line-height: 1.4;
    text-shadow: 0 1px 2px #211308;
    box-shadow: inset 1px 1px 0 #f1dbb53d, inset -1px -1px 0 #0008, 0 2px 0 #392619, 0 4px 5px #39261955;
  }

  .clay-feature-cta-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .clay-feature-cta::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 3px 3px 6px;
    border-radius: 2px;
    background:
      linear-gradient(110deg, transparent 36%, #ffdfa950 50%, transparent 64%) 100% 0 / 260% 100% no-repeat,
      linear-gradient(170deg, #ecce9c12, #21130840),
      var(--keycap-image) 50% 25% / 125% 205% no-repeat #4b3522;
    box-shadow: inset 0 1px 0 #efd6ae60, inset 1px 0 0 #efd6ae24, 0 2px 2px #0007;
  }

  :global(.clay-feature-panel:focus-visible) .clay-feature-cta,
  .clay-feature-cta:focus-visible {
    color: var(--phosphor);
    text-shadow: 0 0 8px #ffbd5966, 0 1px 2px #211308;
  }

  a.clay-feature-cta:focus-visible {
    outline: 2px solid #502713;
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .clay-feature-cta:hover {
      color: var(--phosphor);
      text-shadow: 0 0 8px #ffbd5966, 0 1px 2px #211308;
    }
  }

  .clay-feature-cta:active::before {
    box-shadow: inset 0 2px 3px #21130899, inset 1px 0 0 #efd6ae18;
  }

  @media (prefers-reduced-motion: no-preference) {
    .clay-feature-cta {
      transition: color 120ms ease, text-shadow 120ms ease;
    }

    .clay-feature-cta::before {
      transition: background-position 340ms ease-out, box-shadow 120ms ease,
        transform 150ms cubic-bezier(0.2, 1.55, 0.4, 1);
    }

    .clay-feature-cta-label {
      transition: transform 150ms cubic-bezier(0.2, 1.55, 0.4, 1);
    }

    :global(.clay-feature-panel:focus-visible) .clay-feature-cta::before,
    .clay-feature-cta:focus-visible::before {
      background-position: 0 0, 0 0, 50% 25%;
    }

    @media (hover: hover) {
      .clay-feature-cta:hover::before {
        background-position: 0 0, 0 0, 50% 25%;
      }
    }

    .clay-feature-cta:active::before,
    .clay-feature-cta:active .clay-feature-cta-label {
      transform: translateY(3px);
      transition: transform 40ms ease-out, box-shadow 40ms ease-out;
    }
  }
</style>
