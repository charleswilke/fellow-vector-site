---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import servicesHero from '../assets/services.webp';
import patchbay from '../assets/patchbay.webp';

const services = [
  {
    id: 'consulting',
    label: '01 // consulting',
    title: 'AI Strategy & Consulting',
    color: 'phosphor',
    description: `Start with the work that's eating your time. I help founders, operators, and
    small and mid-sized businesses identify useful AI applications, assess the tools,
    and plan adoption around their actual work. We look at where AI can help and where
    your team's judgment matters most.`,
    bullets: [
      'AI readiness assessments grounded in your current tools and workflows',
      '1:1 strategy sessions to sort through use cases and tool choices',
      'Implementation roadmaps with priorities and ways to evaluate results',
      'Ongoing advice as you test, learn, and refine your approach',
    ],
    outcome: 'The aim: a clear set of priorities and a practical path from experimenting with AI to using it in your day-to-day work.',
    cta: { href: '/book', label: 'Book a Consulting Call' },
  },
  {
    id: 'speaking',
    label: '02 // speaking',
    title: 'AI Speaking & Keynotes',
    color: 'electric',
    description: `A clear signal for audiences sorting through AI noise. I speak about AI adoption,
    human judgment, and what these tools mean for the work people care about.
    Each talk connects that bigger picture to your audience's decisions,
    drawing on my experience shaping an AI assistant used by real businesses.`,
    bullets: [
      'Conference keynotes and panel appearances',
      'Corporate events and executive briefings',
      'Industry association engagements',
      'Custom talk development for your audience',
    ],
    outcome: 'The aim: a shared understanding of AI and better questions to bring back to the work, with concrete next steps for your audience.',
    cta: { href: '/book', label: 'Inquire About Speaking' },
  },
  {
    id: 'webinars',
    label: '03 // webinars',
    title: 'AI Training & Workshops',
    color: 'amber',
    description: `Get your hands on the dials. I design AI training, webinars, and workshops
    around the tasks your team actually does. We practice giving clear instructions,
    evaluating outputs, and fitting AI into a workflow without handing over the judgment.
    There's room to experiment, ask questions, and find what works for your group.`,
    bullets: [
      'Live AI webinars for teams, associations, and communities',
      'Interactive workshops, virtual or in person',
      'Custom exercises and curriculum built around your domain',
      'Cohort-based learning with space to practice and ask questions',
    ],
    outcome: 'The aim: useful techniques your team has practiced, a clearer sense of what to check, and workflows to keep developing after the session.',
    cta: { href: '/book', label: 'Discuss Team Training' },
  },
];
---

<BaseLayout
  title="AI Consulting, Workshops & Speaking"
  description="AI strategy consulting, hands-on team training, and speaking with Charles Wilke. Practical guidance for small and mid-sized businesses, based in Omaha."
>

  <!-- ── Page header ── -->
  <PageHero label="// what we offer" title="AI Consulting & Training" image={servicesHero} imageOpacity={0.55}>
    <p class="text-muted page-hero-sub">
      AI strategy, team workshops, and speaking, built around the work you want
      more time for. I'm Charles Wilke, based in Omaha. You work with me directly,
      from the first conversation through the engagement.
    </p>
  </PageHero>

  <!-- ── Services ── -->
  {services.map((svc, i) => (
    <section id={svc.id} class={`service-section section${i === services.length - 1 ? ' last-service' : ''}`}>
      <div class={`container service-layout ${i % 2 !== 0 ? 'reverse' : ''}`}>

        <div class="service-meta">
          <div class="label" style={`color: var(--${svc.color === 'phosphor' ? 'phosphor' : svc.color === 'electric' ? 'electric' : 'amber'})`}>
            {svc.label}
          </div>
          <div class={`service-index text-${svc.color === 'phosphor' ? 'phosphor' : svc.color === 'electric' ? 'electric' : 'amber'} glow-${svc.color === 'electric' ? 'blue' : svc.color === 'phosphor' ? 'green' : ''}`}>
            0{i + 1}
          </div>
        </div>

        <div class="service-body">
          <h2>{svc.title}</h2>
          <p>{svc.description}</p>

          <ul class="service-bullets">
            {svc.bullets.map(b => (
              <li>
                <span class={`bullet-mark text-${svc.color === 'phosphor' ? 'phosphor' : svc.color === 'electric' ? 'electric' : 'amber'}`}>▸</span>
                {b}
              </li>
            ))}
          </ul>

          <p>{svc.outcome}</p>

          <a href={svc.cta.href} class="btn btn-primary">{svc.cta.label}</a>
        </div>

      </div>
      <hr class="divider container" />
    </section>
  ))}

  <!-- ── CTA ── -->
  <section class="cta-section">
    <div class="cta-bg" aria-hidden="true">
      <Image src={patchbay} alt="" class="cta-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container cta-inner">
      <h2 class="text-phosphor glow-green">Not sure where to start?</h2>
      <p class="text-muted">Let's figure out what's eating your time,<br />and how to get it back.</p>
      <div class="cta-buttons">
        <a href="/book" class="btn btn-primary">Book a Call</a>
        <a href="mailto:cwilke@fellowvector.com" class="btn btn-ghost">Send an Email</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero-sub {
    font-size: 1rem;
    max-width: 55ch;
  }

  .last-service {
    padding-bottom: 0;
  }

  .service-layout {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--sp-xl);
    align-items: start;
  }

  .service-meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding-top: var(--sp-sm);
    position: sticky;
    top: 80px;
  }

  .service-index {
    font-family: var(--font-crt);
    font-size: 4rem;
    line-height: 1;
    opacity: 0.15;
  }

  .service-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .service-body h2 {
    margin-top: var(--sp-xs);
  }

  .service-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    margin: var(--sp-sm) 0;
  }

  .service-bullets li {
    display: flex;
    gap: var(--sp-sm);
    align-items: baseline;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  .bullet-mark {
    flex-shrink: 0;
    font-size: 0.7rem;
  }

  .cta-section {
    position: relative;
    text-align: center;
    padding: var(--sp-2xl) 0;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-top: 1px solid var(--border);
  }

  .cta-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .cta-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.28;
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      rgba(8, 9, 15, 0.3) 0%,
      rgba(8, 9, 15, 0.88) 100%
    );
  }

  .cta-buttons {
    display: flex;
    gap: var(--sp-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-md);
  }

  @media (max-width: 640px) {
    .service-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-md);
    }

    .service-meta {
      position: static;
      flex-direction: row;
      align-items: center;
    }

    .service-index { font-size: 2.5rem; }

    .service-section.section {
      padding: var(--sp-xl) 0;
    }

    .divider.container {
      margin: var(--sp-md) auto;
    }
  }
</style>
