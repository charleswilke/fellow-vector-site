---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import drivingSimulatorHero from '../assets/services-driving-simulator.webp';
import charlesSpeaking from '../assets/charles-speaking.jpg';
import clayChin from '../assets/clay-chin.svg?url';
import clayHeaderFaceplate from '../assets/clay-header-faceplate.webp';
import ClayDisk from '../components/ClayDisk.astro';
import ClayKeycap from '../components/ClayKeycap.astro';
import ClayPreviewPaper from '../components/ClayPreviewPaper.astro';
import { clayEvenings } from '../data/clay-evenings';
import '../styles/clay-feature.css';

// Keep the existing IDs so links from the homepage and saved bookmarks still work.
const services = [
  {
    id: 'consulting',
    title: 'One-to-One Tutoring',
    description: 'Bring a task you want to tackle. Whether you’re opening an AI tool for the first time or building a workflow for your business, we’ll use your real work as the lesson so you can take the next step on your own.',
    examples: [
      'Practice giving AI useful context and clear instructions',
      'Check the results and decide when AI helps',
      'Build a workflow you can understand and use again',
    ],
  },
  {
    id: 'webinars',
    title: 'Team Workshops',
    description: 'I shape each workshop around a role or task your team knows well. People get hands-on practice with AI, compare results, and decide together what they’d use in their day-to-day work.',
    examples: [
      'Work with scenarios drawn from your team’s roles and tools',
      'Practice reviewing AI output and handling work information responsibly',
      'Meet in person or live online',
    ],
  },
  {
    id: 'speaking',
    title: 'Speaking & Keynotes',
    description: 'I speak about learning by doing, where human judgment matters, and how automation can give people more room to do meaningful work. I bring examples from the kinds of decisions your audience faces and make room for honest questions.',
  },
];
---

<BaseLayout
  title="AI Tutoring, Workshops & Speaking"
  description="Learn AI one-to-one or with your team. Practical tutoring, role-focused workshops, and talks with Charles Wilke, from first steps to full business applications."
>
  <PageHero
    class="services-hero"
    label="// ways to learn"
    title="AI Tutoring & Workshops"
    image={drivingSimulatorHero}
    imageOpacity={0.82}
    imagePosition="58% center"
    preserveImageColor
  >
    <p class="text-muted page-hero-sub">
      Think AI driver's ed: learn the controls, practice on real work, and
      build your judgment along the way. I'm Charles Wilke, based in Omaha.
    </p>
    <div class="hero-booking">
      <p>Start with a conversation. Tell me what you’re working on and we’ll figure out what kind of help fits.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/book">Book a free call</a>
        <a class="text-link hero-services-link" href="#services">See the services <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </PageHero>

  <!-- ── Throw More Clay series ── -->
  <section id="clay" class="section clay-section" aria-labelledby="clay-title">
    <div class="container">
      <div class="clay-feature-panel clay-service-panel" style={`--clay-faceplate: url("${clayHeaderFaceplate.src}")`}>
        <header class="clay-panel-header">
          <p class="clay-series-mark">Live AI Series for Creatives</p>
        </header>
        <div class="clay-feature-copy">
          <h2 id="clay-title">Throw More Clay</h2>
          <p class="clay-feature-description">
            Three live evenings for creatives making their way in the AI era:
            designers, writers, musicians, illustrators, and theater and video
            makers.
          </p>
        </div>
        <p id="clay-preview-label" class="clay-label-tape">Select an evening to preview</p>
        <fieldset class="clay-evenings" aria-labelledby="clay-preview-label">
          <div class="clay-dates">
            {clayEvenings.map((evening, index) => (
              <>
                <ClayDisk
                  id={`clay-evening-${index + 1}`}
                  eveningIndex={index}
                  day={evening.day}
                  title={evening.title}
                  name="clay-evening"
                  descriptionId={`clay-preview-${index + 1}`}
                  sizes="(max-width: 760px) 30vw, 180px"
                  shutterSizes="(max-width: 760px) 15vw, 86px"
                />
                <ClayPreviewPaper id={`clay-preview-${index + 1}`}>
                  <p class="clay-preview-title">{evening.title}</p>
                  <p>{evening.preview}</p>
                </ClayPreviewPaper>
              </>
            ))}
            <ClayPreviewPaper class="clay-preview-intro">
              <p class="clay-preview-title">What to expect</p>
              <dl class="clay-project-details">
                <dt>Start with</dt>
                <dd>One project you care about.</dd>
                <dt>Leave with</dt>
                <dd>A piece you directed and stand behind.</dd>
              </dl>
            </ClayPreviewPaper>
          </div>
        </fieldset>
        <div class="clay-schedule">
          <p class="clay-event-mark">Upcoming event</p>
          <p class="clay-schedule-details">
            <strong><time datetime="2027-01">January 2027</time> · 6 to 8 pm CST</strong>
            <span>Live online · 12 seats</span>
          </p>
        </div>
        <div class="clay-panel-chin" style={`--clay-chin-image: url("${clayChin}")`}>
          <div class="clay-buttons">
            <ClayKeycap href="/clay">See the Series</ClayKeycap>
            <ClayKeycap href="/clay/interest">Join the Interest List</ClayKeycap>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="section" aria-labelledby="services-title" tabindex="-1">
    <div class="container">
      <h2 id="services-title">Three ways to work together</h2>
      <div class="services-list">
        {services.map(({ id, title, description, examples }) => (
          <section class="service-detail" id={id} aria-labelledby={`${id}-title`} tabindex="-1">
            <div class="service-copy">
              <h3 id={`${id}-title`}>{title}</h3>
              <p class="text-muted">{description}</p>
              {id === 'speaking' && (
                <p>Keynotes, conference panels, and talks for teams, associations, and communities.</p>
              )}
              {id === 'webinars' && (
                <figure class="recommendation">
                  <blockquote>
                    <p>“He was always proactively experimenting … spearheading an AI education project to ensure our entire team was up to date and proficient in new tools.”</p>
                  </blockquote>
                  <figcaption class="text-muted">Estella Aditirto, Technical Writer, GoDaddy</figcaption>
                </figure>
              )}
            </div>
            {examples && (
              <ul class="service-examples">
                {examples.map((example) => <li>{example}</li>)}
              </ul>
            )}
            {id === 'speaking' && (
              <figure class="speaking-photo">
                <a class="speaking-photo-link" href={charlesSpeaking.src} aria-label="View the full-size photo of Charles presenting Spectator to Initiator">
                  <Image
                    src={charlesSpeaking}
                    alt="Charles Wilke presenting Spectator to Initiator, with the projected talk and seated audience visible."
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 700px) calc(100vw - 64px), (max-width: 1200px) 45vw, 460px"
                    format="webp"
                    loading="lazy"
                  />
                </a>
                <figcaption>
                  <cite>Spectator to Initiator</cite>
                  <a class="text-link" href="https://charleswilke.com/s2i">Explore the talk deck <span aria-hidden="true">↗</span></a>
                </figcaption>
              </figure>
            )}
          </section>
        ))}
      </div>
      <a class="btn btn-primary services-booking" href="/book">Book a free 30-minute call</a>
    </div>
  </section>

</BaseLayout>

<script>
  const evenings = document.querySelector('.clay-evenings');
  const firstDisk = evenings?.querySelector('.clay-disk');

  if (evenings) {
    const strips = evenings.querySelectorAll<HTMLButtonElement>('[data-paper-strip]');

    for (const strip of strips) {
      strip.disabled = false;
      const direction = strip.dataset.paperStrip === 'left' ? -1 : 1;
      const tearSteps = 5;
      let tearStep = 0;
      let dragged = false;
      let pull: { pointerId: number; startX: number; startY: number; startStep: number } | undefined;

      function tearStrip(method: 'activate' | 'pull') {
        if (strip.disabled) return;
        if (document.activeElement === strip) {
          strip.parentElement?.querySelector<HTMLElement>('.clay-paper-body')?.focus({ preventScroll: true });
        }
        strip.disabled = true;
        strip.dataset.torn = method;
      }

      strip.addEventListener('click', (event) => {
        if (!dragged || event.detail === 0) tearStrip('activate');
      });
      strip.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary || event.button !== 0) return;
        dragged = false;
        pull = {
          pointerId: event.pointerId,
          startX: event.clientX,
          startY: event.clientY,
          startStep: tearStep,
        };
        strip.setPointerCapture(event.pointerId);
      });
      strip.addEventListener('pointermove', (event) => {
        if (strip.disabled || pull?.pointerId !== event.pointerId) return;
        const dx = event.clientX - pull.startX;
        const dy = event.clientY - pull.startY;
        if (Math.hypot(dx, dy) > 5) dragged = true;
        const outward = dx * direction;
        if (outward < 6) return;

        // Each advance breaks another section of the perforation, even if the pull eases.
        const distance = outward + Math.max(0, dy) * 0.5;
        const nextStep = Math.min(tearSteps, pull.startStep + Math.floor(distance / 8));
        if (nextStep <= tearStep) return;
        tearStep = nextStep;
        strip.style.setProperty('--paper-tear', `${tearStep / tearSteps * 100}%`);
        if (tearStep === tearSteps) tearStrip('pull');
      });
      strip.addEventListener('lostpointercapture', () => {
        pull = undefined;
      });

      evenings.addEventListener('change', () => {
        pull = undefined;
        tearStep = 0;
        dragged = false;
        strip.style.removeProperty('--paper-tear');
        strip.removeAttribute('data-torn');
        strip.disabled = false;
      });
    }
  }

  if (evenings && firstDisk) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && entry.intersectionRatio >= 0.65) {
        evenings.setAttribute('data-disk-hint', '');
        observer.disconnect();
      }
    }, { threshold: 0.65 });

    function dismissHint() {
      observer.disconnect();
      evenings?.removeAttribute('data-disk-hint');
    }

    evenings.addEventListener('pointerenter', dismissHint, { once: true });
    evenings.addEventListener('focusin', dismissHint, { once: true });
    evenings.addEventListener('change', dismissHint, { once: true });
    observer.observe(firstDisk);
  }
</script>

<style>
  .services-hero {
    --page-hero-horizontal-fade: linear-gradient(to right,
      var(--bg) 22%,
      rgba(var(--bg-rgb), 0.86) clamp(48%, 30rem, 72%),
      rgba(var(--bg-rgb), 0.34) 86%,
      rgba(var(--bg-rgb), 0.2) 100%
    );
  }

  .page-hero-sub,
  .hero-booking p {
    max-width: 55ch;
  }

  .hero-booking {
    display: grid;
    justify-items: start;
    gap: var(--sp-md);
    margin-top: var(--sp-sm);
  }

  .hero-booking .btn {
    max-width: 100%;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-xs) var(--sp-md);
  }

  .hero-services-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-xs);
    min-height: 2.75rem;
    font-size: 0.875rem;
  }

  .services-list {
    margin-top: clamp(1rem, 3vw, 1.5rem);
    border-bottom: 1px solid var(--border);
  }

  .service-detail {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--layout-gap);
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--border);
  }

  .service-detail:target h3 {
    color: var(--phosphor);
  }

  .service-copy {
    display: grid;
    gap: var(--sp-sm);
  }

  .service-copy h3 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .service-examples {
    display: grid;
    gap: var(--sp-sm);
    padding: var(--sp-md) var(--sp-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    line-height: 1.5;
  }

  .service-examples li::marker {
    color: var(--phosphor);
  }

  .text-link {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .services-booking {
    margin-top: var(--sp-md);
  }

  .recommendation {
    margin-top: var(--sp-sm);
    padding-inline-start: var(--sp-md);
    border-inline-start: 1px solid var(--phosphor-dim);
    font-size: 0.9rem;
  }

  .recommendation figcaption {
    margin-top: var(--sp-xs);
    font-size: 0.8rem;
  }

  .speaking-photo {
    width: 100%;
    max-width: 34rem;
    padding: 0.65rem;
    background: #eaddbf;
    color: #382414;
    box-shadow: 0 1px #ad9772, 0 3px #100a0559, 0 8px 24px #100a052e;
  }

  .speaking-photo-link,
  .speaking-photo img {
    display: block;
  }

  .speaking-photo img {
    width: 100%;
    height: auto;
  }

  .speaking-photo figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-xs) var(--sp-md);
    padding: var(--sp-sm) var(--sp-xs) var(--sp-xs);
  }

  .speaking-photo cite {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: normal;
  }

  .speaking-photo figcaption a {
    color: #604020;
    font-size: 0.875rem;
  }

  .speaking-photo a:focus-visible {
    outline: 2px solid #382414;
    outline-offset: 2px;
  }

  .clay-section {
    border-bottom: 1px solid var(--border);
  }

  .clay-service-panel {
    --electric: #502713;
    --clay-title-size: min(4.5rem, 16cqi);
    align-items: start;
    row-gap: 0.7rem;
    padding-block-start: 0;
    grid-template-areas: "header" "copy" "preview-label" "evenings" "schedule" "chin";
  }

  @media (min-width: 761px) {
    .clay-service-panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
      grid-template-areas: "header preview-label" "copy evenings" "schedule evenings" "chin chin";
    }
  }

  .clay-panel-header {
    grid-area: header;
    container-type: inline-size;
    padding-block: 0.85rem;
  }

  .clay-service-panel::before {
    content: '';
    grid-area: 1 / 1 / 2 / -1;
    align-self: stretch;
    margin-inline: calc(-1 * var(--clay-feature-padding));
    border-bottom: 1px solid #876542;
    background: #c8aa7e var(--clay-faceplate) center / 100% 100% no-repeat;
  }

  .clay-series-mark {
    /* The mark and title scale from the same column width. */
    font-family: 'Courier New', Courier, monospace;
    font-size: calc(var(--clay-title-size) * 0.36);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    text-shadow: 0 1px #f9e0b37a;
    white-space: nowrap;
  }

  .clay-label-tape {
    grid-area: preview-label;
    place-self: center;
    padding: 0.3rem 0.65rem;
    border: 1px solid #68472f;
    border-radius: 1px;
    background: linear-gradient(175deg, #4c3020, #29170e);
    box-shadow: inset 0 1px #98674680, 0 1px 2px #51321f66;
    color: #ffe8c0;
    font-family: system-ui, sans-serif;
    font-size: clamp(0.7rem, 3.4vw, 0.875rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.07em;
    text-align: center;
    text-transform: uppercase;
    transform: translateY(2px) rotate(-0.42deg);
  }

  .clay-service-panel .clay-feature-copy {
    grid-area: copy;
    container-type: inline-size;
  }

  .clay-service-panel .clay-feature-copy h2 {
    font-size: var(--clay-title-size);
    white-space: nowrap;
  }

  .clay-evenings {
    grid-area: evenings;
    min-inline-size: 0;
    padding: 0;
    border: 0;
    container-type: inline-size;
  }

  .clay-dates {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.5rem, 2cqi, 0.75rem);
  }

  .clay-dates > :global(.clay-disk) { grid-row: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .clay-evenings[data-disk-hint] :global(.clay-disk:first-of-type .clay-disk-shutter) {
      animation: clay-shutter-wink 660ms 450ms ease-in-out;
    }
  }

  @keyframes clay-shutter-wink {
    0%, 100% { transform: translateX(0); }
    32%, 60% { transform: translateX(-24%); }
  }

  /* Stack all previews in one grid cell so its height fits the longest one. */
  .clay-dates > :global(.clay-preview) {
    visibility: hidden;
    grid-area: 2 / 1 / 3 / -1;
  }

  .clay-preview-title {
    margin-bottom: 0.35rem;
    font-family: var(--font-crt);
    font-size: 1.55rem;
    line-height: 1;
  }

  .clay-project-details {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: baseline;
    gap: 0.2rem 0.8rem;
    line-height: 1.45;
  }

  .clay-project-details dt {
    color: #554935;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .clay-dates:not(:has(> :checked)) > :global(.clay-preview-intro),
  .clay-dates > :global(.clay-disk-input:checked + .clay-disk + .clay-preview) {
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .clay-dates > :global(.clay-disk-input:checked + .clay-disk + .clay-preview) {
      animation: clay-paper-feed 620ms linear;
    }
  }

  @keyframes clay-paper-feed {
    /* Match the offset and bottom crop so the paper rises through a fixed edge. */
    0%, 10% { clip-path: inset(0 0 94%); transform: translateY(94%); }
    15%, 33% { clip-path: inset(0 0 68%); transform: translateY(68%); }
    37%, 49% { clip-path: inset(0 0 52%); transform: translateY(52%); }
    54%, 75% { clip-path: inset(0 0 28%); transform: translateY(28%); }
    80%, 90% { clip-path: inset(0 0 12%); transform: translateY(12%); }
    95%, 100% { clip-path: inset(0); transform: translateY(0); }
  }

  .clay-schedule {
    grid-area: schedule;
    align-self: end;
    display: grid;
    gap: 0.35rem;
    color: #502713;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .clay-schedule-details {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.85rem;
  }

  .clay-schedule-details strong {
    font-size: 0.9rem;
  }

  .clay-event-mark {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.45rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid #704b30;
    border-radius: 2px;
    background: #40291b;
    box-shadow: inset 0 1px #8d5d3e, 0 1px #f9d6a4;
    color: #ffe8bb;
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .clay-event-mark::before {
    content: '';
    flex: 0 0 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 30%, #fff5cc 6%, #ffbd58 50%, #ae531e 87%);
    box-shadow: 0 0 0 1px #29170d, 0 0 5px #ffad4a80;
  }

  .clay-panel-chin {
    --clay-chin-taper: min(clamp(4.5rem, 25vw, 19rem), 28%);
    --clay-chin-key-width: min(22.4rem, calc(100% - var(--clay-chin-taper) - 0.65rem));
    grid-area: chin;
    display: grid;
    position: relative;
    isolation: isolate;
    margin-inline: calc(-1 * var(--clay-feature-padding));
    margin-block-end: calc(-1 * var(--clay-feature-padding));
  }

  /* Give the shoulder its own width so the bevel follows the taper from the keys to the rail. */
  .clay-panel-chin::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    border-image-source: var(--clay-chin-image);
    border-image-slice: 0 280 0 320 fill;
    border-image-width: 0 calc(100% - var(--clay-chin-key-width) - var(--clay-chin-taper)) 0 var(--clay-chin-key-width);
  }

  .clay-buttons {
    display: flex;
    justify-self: start;
    flex-wrap: wrap;
    gap: 4px;
    width: var(--clay-chin-key-width);
    padding: 0.625rem 5px 7px;
    font-size: 0.9rem;
  }

  .clay-buttons > :global(a) {
    flex: 1 1 auto;
    min-width: 0;
  }

  .clay-buttons :global(.clay-feature-cta-label) {
    justify-content: center;
    text-align: center;
  }

  @media (max-width: 760px) {
    .clay-panel-chin {
      border-top: 1px solid #876542;
      background: linear-gradient(#e4c99a, #b69262);
      box-shadow: inset 0 1px #f8e0b6, inset 0 -2px #8e6b45;
    }

    .clay-panel-chin::before { content: none; }

    .clay-buttons {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      width: 100%;
      gap: 6px;
      padding: 0.45rem 6px 8px;
      font-size: clamp(0.8rem, 3.4vw, 0.9rem);
    }

    .clay-buttons > :global(a) {
      display: grid;
      place-items: center;
      min-height: 44px;
      padding-inline: 0.4rem;
    }
  }

  @media (max-width: 700px) {
    .service-detail {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-md);
    }
  }
</style>
