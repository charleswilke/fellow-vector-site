---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import servicesHero from '../assets/services.webp';
import patchbay from '../assets/patchbay.webp';
import charlesSpeaking from '../assets/charles-speaking.jpg';
import clayChin from '../assets/clay-chin.svg?url';
import clayHeaderFaceplate from '../assets/clay-header-faceplate.webp';
import clayPreviewLabelTape from '../assets/clay-preview-label-tape.webp';
import ClayDisk from '../components/ClayDisk.astro';
import ClayKeycap from '../components/ClayKeycap.astro';
import { clayEvenings } from '../data/clay-evenings';
import '../styles/clay-feature.css';

// Keep the existing section IDs so saved links still reach the right offering.
const services = [
  {
    id: 'consulting',
    label: '01 // one-to-one tutoring',
    title: 'One-to-One AI Tutoring',
    color: 'phosphor',
    description: `Start with something you want to understand or do. I work alongside you,
    using your questions and real tasks as the lesson. You might be opening an AI tool
    for the first time or working toward a full business application. The starting point
    is your role, your curiosity, and what would make you more capable.`,
    bullets: [
      'Learn the tools through a task that matters to you',
      'Practice giving context, asking useful questions, and checking results',
      'Build workflows and applications together, with room to understand each step',
      'Develop the judgment to know when AI helps and when to take another approach',
    ],
    outcome: 'The aim: something useful you understand, skills you can use again, and a clearer next step to practice on your own.',
    cta: { href: '/book', label: 'Talk About Tutoring' },
  },
  {
    id: 'speaking',
    label: '02 // speaking',
    title: 'AI Speaking & Keynotes',
    color: 'electric',
    description: `A shared starting point for people sorting through AI noise. I speak about
    learning by doing, human judgment, and how automation can expand what people are able
    to do. Each talk connects the bigger picture to your audience's own work, with room
    for curiosity and honest questions about what these changes mean for employees.`,
    bullets: [
      'Conference keynotes and panel conversations',
      'Talks for teams, associations, and communities',
      'AI, meaningful work, and employee agency',
      'Examples and next steps shaped around your audience',
    ],
    outcome: 'The aim: a clearer understanding of the tools, better questions, and something your audience feels ready to try.',
    cta: { href: '/book', label: 'Inquire About Speaking' },
  },
  {
    id: 'webinars',
    label: '03 // learning together',
    title: 'Role-Focused Workshops',
    color: 'amber',
    description: `Build capacity with the people doing the work. I shape hands-on sessions
    around a specific role or a task your team recognizes. We practice, compare results,
    and talk through the choices together. The work can grow from a useful everyday
    workflow into a full business application, with the people who use it involved throughout.`,
    bullets: [
      'Live workshops and webinars, virtual or in person',
      'Exercises built around your role, tools, and experience level',
      'Practice with instructions, output review, and responsible use of work information',
      'Shared learning that keeps employee knowledge and judgment at the center',
    ],
    outcome: 'The aim: people who can use and question the tools, explain their choices, and keep developing what they have learned.',
    cta: { href: '/book', label: 'Plan a Workshop' },
  },
];

---

<BaseLayout
  title="AI Tutoring, Workshops & Speaking"
  description="Learn AI one-to-one or with your team. Practical tutoring, role-focused workshops, and talks with Charles Wilke, from first steps to full business applications."
>

  <!-- ── Page header ── -->
  <PageHero label="// ways to learn" title="AI Tutoring & Workshops" image={servicesHero} imageOpacity={0.55}>
    <p class="text-muted page-hero-sub">
      Think AI driver's ed: learn the controls, practice on real work, and
      build your judgment along the way. I'm Charles Wilke, based in Omaha.
      You can learn with me one-to-one, with your team, or in a small-group series.
    </p>
  </PageHero>

  <!-- ── Throw More Clay series ── -->
  <section id="clay" class="section clay-section" aria-labelledby="clay-title">
    <div class="container">
      <div class="clay-feature-panel clay-service-panel" style={`--clay-faceplate: url("${clayHeaderFaceplate.src}")`}>
        <header class="clay-panel-header">
          <p class="clay-feature-kicker">
            <span class="clay-event-mark">
              <span class="clay-event-bulb" aria-hidden="true"></span>
              <span class="clay-event-sticker">Upcoming event</span>
            </span>
            <span>Live AI series for creatives</span>
          </p>
          <Image
            id="clay-preview-label"
            class="clay-label-tape"
            src={clayPreviewLabelTape}
            alt="Choose an evening to preview"
            widths={[300, 600, 900]}
            sizes="18rem"
          />
        </header>
        <div class="clay-feature-copy">
          <h2 id="clay-title">Throw More Clay</h2>
          <p class="clay-feature-description">
            Three live evenings for creatives making their way in the AI era:
            designers, writers, musicians, illustrators, and theater and video
            makers. Bring one project you care about. Leave with a piece you
            directed and stand behind.
          </p>
        </div>
        <fieldset class="clay-evenings" aria-labelledby="clay-preview-label">
          <div class="clay-dates">
            {clayEvenings.map((evening, index) => (
              <>
                <ClayDisk
                  id={`clay-evening-${index + 1}`}
                  eveningIndex={index}
                  day={evening.day}
                  title={evening.title}
                  name="clay-evening"
                  descriptionId={`clay-preview-${index + 1}`}
                  sizes="(max-width: 760px) 30vw, 180px"
                  shutterSizes="(max-width: 760px) 15vw, 86px"
                />
                <div class="clay-preview" id={`clay-preview-${index + 1}`}>
                  <p class="clay-preview-title">{evening.title}</p>
                  <p>{evening.preview}</p>
                </div>
              </>
            ))}
          </div>
        </fieldset>
        <p class="clay-small">
          January 2027 · 6 to 8 pm CST · live online · 12&nbsp;seats
        </p>
        <div class="clay-panel-chin" style={`--clay-chin-image: url("${clayChin}")`}>
          <div class="clay-buttons">
            <ClayKeycap href="/clay">See the Series</ClayKeycap>
            <ClayKeycap href="/clay/interest">Join the Interest List</ClayKeycap>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section conversation-section">
    <div class="container conversation-layout">
      <div class="conversation-heading">
        <div class="label">// first contact</div>
        <h2>Start with a conversation.</h2>
      </div>
      <div class="conversation-body">
        <p>
          A 30-minute conversation about what you want to learn, the work you
          do, and where you're getting stuck. You don't need a technical
          background or a finished project brief.
        </p>
        <p class="text-muted">
          From there, we can shape a useful next step: individual tutoring,
          learning together as a team, or a talk for your audience.
        </p>
        <a href="/book" class="btn btn-primary">Book an Exploratory Call</a>
      </div>
    </div>
  </section>

  <!-- ── Services ── -->
  {services.map((svc) => (
    <section id={svc.id} class="service-section section">
      <div class="container service-layout">

        <div class="service-meta">
          <div class="label" style={`color: var(--${svc.color === 'phosphor' ? 'phosphor' : svc.color === 'electric' ? 'electric' : 'amber'})`}>
            {svc.label}
          </div>
        </div>

        <div class="service-body">
          <h2>{svc.title}</h2>
          <p>{svc.description}</p>

          <div class:list={['service-content', { 'speaking-content': svc.id === 'speaking' }]}>
            {svc.id === 'speaking' && (
              <figure class="speaking-photo">
                <a
                  class="speaking-photo-link"
                  href={charlesSpeaking.src}
                  target="_blank"
                  rel="noopener"
                  aria-label="View the full-size photo of Charles presenting Spectator to Initiator"
                >
                  <Image
                    src={charlesSpeaking}
                    alt="Charles Wilke presenting Spectator to Initiator, with the projected talk and seated audience visible."
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 700px) calc(100vw - 64px), (max-width: 959px) 55vw, 500px"
                    format="webp"
                    loading="lazy"
                  />
                  <span class="speaking-photo-zoom" aria-hidden="true">View photo ↗</span>
                </a>
                <figcaption>
                  <span class="speaking-photo-label">In the room / Charles Wilke</span>
                  <cite>Spectator to Initiator</cite>
                  <a href="https://charleswilke.com/s2i" target="_blank" rel="noopener">Explore the talk deck <span aria-hidden="true">↗</span></a>
                </figcaption>
              </figure>
            )}

            <div class="service-details">
              <ul class="service-bullets">
                {svc.bullets.map(b => (
                  <li>
                    <span class={`bullet-mark text-${svc.color === 'phosphor' ? 'phosphor' : svc.color === 'electric' ? 'electric' : 'amber'}`}>▸</span>
                    {b}
                  </li>
                ))}
              </ul>

              <p>{svc.outcome}</p>

              {svc.id === 'webinars' && (
                <figure class="recommendation">
                  <div class="label">// from a colleague</div>
                  <blockquote>
                    <p>
                      “He was always proactively experimenting … spearheading an AI
                      education project to ensure our entire team was up to date
                      and proficient in new tools.”
                    </p>
                  </blockquote>
                  <figcaption>
                    <span class="recommendation-name">Estella Aditirto</span>
                    <span class="text-muted">Technical Writer, GoDaddy</span>
                  </figcaption>
                </figure>
              )}

              <a href={svc.cta.href} class="btn btn-primary">{svc.cta.label}</a>
            </div>
          </div>
        </div>

      </div>
    </section>
  ))}

  <!-- ── CTA ── -->
  <section class="cta-section">
    <div class="cta-bg" aria-hidden="true">
      <Image src={patchbay} alt="" class="cta-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container cta-inner">
      <h2 class="closing-cta-title text-phosphor glow-phosphor">Let's find a useful next step.</h2>
      <p class="text-muted">Bring your questions and something you'd like to learn to do.<br />We'll start with a 30-minute exploratory conversation.</p>
      <div class="cta-buttons">
        <a href="/book" class="btn btn-primary">Book an Exploratory Call</a>
        <a href="mailto:cwilke@fellowvector.com" class="btn btn-ghost">Send an Email</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const evenings = document.querySelector('.clay-evenings');
  const firstDisk = evenings?.querySelector('.clay-disk');

  if (evenings && firstDisk) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && entry.intersectionRatio >= 0.65) {
        evenings.setAttribute('data-disk-hint', '');
        observer.disconnect();
      }
    }, { threshold: 0.65 });

    function dismissHint() {
      observer.disconnect();
      evenings?.removeAttribute('data-disk-hint');
    }

    evenings.addEventListener('pointerenter', dismissHint, { once: true });
    evenings.addEventListener('focusin', dismissHint, { once: true });
    observer.observe(firstDisk);
  }
</script>

<style>
  .page-hero-sub {
    font-size: 1rem;
    max-width: 55ch;
  }

  .conversation-section {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .conversation-layout {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--layout-gap);
    align-items: start;
  }

  .conversation-heading,
  .conversation-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .conversation-body .btn {
    align-self: flex-start;
    max-width: 100%;
    text-align: center;
  }

  .recommendation {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
    margin: var(--sp-md) 0;
    padding: var(--sp-lg);
    border: 1px solid var(--border);
    border-left: 2px solid var(--amber);
    background: var(--bg-surface);
  }

  .recommendation .label {
    color: var(--amber);
  }

  .recommendation figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    font-size: 0.85rem;
  }

  .recommendation-name {
    color: var(--amber);
  }

  @media (max-width: 768px) {
    .conversation-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-lg);
    }
  }

  .clay-section {
    border-bottom: 1px solid var(--border);
  }

  .clay-service-panel {
    --electric: #502713;
    align-items: start;
    row-gap: 0.7rem;
    grid-template-areas: "header" "copy" "evenings" "schedule" "chin";
  }

  @media (min-width: 761px) {
    .clay-service-panel {
      --clay-service-columns: minmax(0, 1fr) minmax(0, 1.45fr);
      grid-template-columns: var(--clay-service-columns);
      grid-template-areas: "header header" "copy evenings" "schedule evenings" "chin chin";
    }

    .clay-panel-header {
      grid-template-columns: var(--clay-service-columns);
      column-gap: inherit;
    }
  }

  .clay-panel-header {
    grid-area: header;
    display: grid;
    align-items: center;
    row-gap: 0.5rem;
    margin-block-start: calc(-1 * var(--clay-feature-padding));
    margin-inline: calc(-1 * var(--clay-feature-padding));
    padding: 0.55rem var(--clay-feature-padding);
    border-bottom: 1px solid #876542;
    background: #c8aa7e var(--clay-faceplate) center / 100% 100% no-repeat;
  }

  .clay-event-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .clay-event-bulb {
    position: relative;
    flex: 0 0 0.52rem;
    height: 0.52rem;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 30%,
      #fff7d6 4%, #ffe1a0 24%, #ffb74c 56%, #b66025 87%);
    box-shadow: 0 0 0 2px #62452c, 0 1px 0 3px #edcfa2;
  }

  .clay-event-bulb::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 10px 3px #ffa73b;
    opacity: 0.35;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .clay-event-bulb::after {
      animation: clay-bulb-pulse 4.8s ease-in-out infinite;
    }
  }

  @keyframes clay-bulb-pulse {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.72; }
  }

  .clay-event-sticker {
    padding: 0.3em 0.65em;
    border-radius: 1px 3px 2px 1px;
    background: linear-gradient(165deg, #ffefcd, #ead2a6);
    color: #422819;
    font-weight: 700;
    box-shadow: inset 0 1px 0 #fff7e1, 0 1px 2px #51321f55;
    transform: rotate(-0.75deg);
  }

  .clay-label-tape {
    justify-self: start;
    display: block;
    width: min(100%, 18rem);
    height: auto;
    filter: drop-shadow(0 1px 1px #51321f55);
    transform: rotate(-2deg);
  }

  .clay-service-panel .clay-feature-copy {
    grid-area: copy;
    container-type: inline-size;
  }

  .clay-service-panel .clay-feature-copy h2 {
    font-size: min(4.5rem, 16cqi);
    white-space: nowrap;
  }

  .clay-evenings {
    grid-area: evenings;
    min-inline-size: 0;
    padding: 0;
    border: 0;
    container-type: inline-size;
  }

  .clay-dates {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.5rem, 2cqi, 0.75rem);
  }

  .clay-dates > :global(.clay-disk) { grid-row: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .clay-evenings[data-disk-hint] :global(.clay-disk:first-of-type) {
      animation: clay-disk-hint 720ms 380ms ease-in-out;
    }
  }

  @keyframes clay-disk-hint {
    0%, 100% { transform: none; }
    32%, 60% { transform: translateY(-0.15rem) rotate(-3deg); }
  }

  /* Stack all previews in one grid cell so its height fits the longest one. */
  .clay-preview {
    visibility: hidden;
    grid-area: 2 / 1 / 3 / -1;
    max-width: none;
    padding: 0.5rem 0.85rem;
    border-left: 2px solid #805232;
    background: #fff2d966;
    font-size: 0.9rem;
  }

  .clay-preview-title {
    margin-bottom: 0.35rem;
    color: #502713;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
    text-shadow: 0.25px 0 currentColor;
  }

  .clay-dates > :global(.clay-disk-input:checked) + :global(.clay-disk) + .clay-preview {
    visibility: visible;
  }

  .clay-small {
    grid-area: schedule;
    align-self: end;
    color: #502713;
    font-size: 0.8rem;
  }

  .clay-panel-chin {
    --clay-chin-taper: min(clamp(4.5rem, 25vw, 19rem), 28%);
    --clay-chin-key-width: min(22.4rem, calc(100% - var(--clay-chin-taper) - 0.65rem));
    grid-area: chin;
    display: grid;
    position: relative;
    isolation: isolate;
    margin-inline: calc(-1 * var(--clay-feature-padding));
    margin-block-end: calc(-1 * var(--clay-feature-padding));
  }

  /* Give the shoulder its own width so the bevel follows the taper from the keys to the rail. */
  .clay-panel-chin::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    border-image-source: var(--clay-chin-image);
    border-image-slice: 0 280 0 320 fill;
    border-image-width: 0 calc(100% - var(--clay-chin-key-width) - var(--clay-chin-taper)) 0 var(--clay-chin-key-width);
  }

  .clay-buttons {
    display: flex;
    justify-self: start;
    flex-wrap: wrap;
    gap: 4px;
    width: var(--clay-chin-key-width);
    padding: 0.625rem 5px 7px;
    font-size: 0.9rem;
  }

  .clay-buttons > :global(a) {
    flex: 1 1 auto;
    min-width: 0;
  }

  .clay-buttons :global(.clay-feature-cta-label) {
    justify-content: center;
    text-align: center;
  }

  .service-section + .service-section {
    border-top: 1px solid var(--border);
  }

  .service-layout {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: var(--layout-gap);
    align-items: start;
  }

  .service-meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding-top: var(--sp-sm);
    position: sticky;
    top: calc(var(--nav-height) + 16px);
  }

  .service-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .service-body h2 {
    margin-top: var(--sp-xs);
  }

  .service-content,
  .service-details {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
    min-width: 0;
  }

  .speaking-content {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(15rem, 0.85fr);
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin-top: var(--sp-md);
  }

  .speaking-photo {
    margin: 0;
    padding: 0.75rem 0.75rem 0;
    background: #eaddbf;
    color: #382414;
    box-shadow: 0 1px 0 #ad9772, 0 3px 0 rgba(16, 10, 5, 0.35),
      0 8px 24px rgba(16, 10, 5, 0.18);
    transform: rotate(-0.6deg);
  }

  .speaking-photo-link {
    display: block;
    position: relative;
    background: #b9b5a5;
    outline: 1px solid rgba(56, 36, 20, 0.18);
  }

  .speaking-photo-link:focus-visible {
    outline: 2px solid #382414;
    outline-offset: 4px;
  }

  .speaking-photo-zoom {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.25rem 0.5rem;
    background: rgba(36, 28, 19, 0.88);
    color: var(--fg);
    font-size: 0.7rem;
    line-height: 1.4;
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
  }

  .speaking-photo-link:is(:hover, :focus-visible) .speaking-photo-zoom {
    opacity: 1;
  }

  .speaking-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .speaking-photo figcaption {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 1rem 0.35rem 1.15rem;
    color: #382414;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .speaking-photo-label {
    font-size: 0.65rem;
    line-height: 1.4;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #765737;
  }

  .speaking-photo cite {
    font-family: var(--font-crt);
    font-style: normal;
    font-size: clamp(1.5rem, 2.7vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .speaking-photo figcaption a {
    color: #604020;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .speaking-photo figcaption a:hover { color: #382414; text-shadow: none; }

  .speaking-content .service-bullets { margin-top: 0; }

  .speaking-content .service-details > p { font-size: 0.9rem; }

  .service-details > .btn {
    align-self: flex-start;
    max-width: 100%;
    text-align: center;
  }

  @media (max-width: 700px) {
    .speaking-content { grid-template-columns: minmax(0, 1fr); }
    .speaking-photo { max-width: 34rem; }
    .speaking-photo-label { font-size: 0.7rem; }
    .speaking-photo-zoom { opacity: 1; }
  }

  .service-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    margin: var(--sp-sm) 0;
  }

  .service-bullets li {
    display: flex;
    gap: var(--sp-sm);
    align-items: baseline;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  .bullet-mark {
    flex-shrink: 0;
    font-size: 0.7rem;
  }

  .cta-section {
    position: relative;
    text-align: center;
    padding: var(--section-space) 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-top: 1px solid var(--border);
  }

  .cta-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .cta-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.28;
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
