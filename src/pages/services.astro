---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import servicesHero from '../assets/services.webp';
import patchbay from '../assets/patchbay.webp';
import charlesSpeaking from '../assets/charles-speaking.jpg';

const services = [
  {
    id: 'consulting',
    label: '01 // consulting',
    title: 'AI Strategy & Consulting',
    color: 'phosphor',
    description: `Start with the work that's eating your time. I help founders, operators, and
    small and mid-sized businesses identify useful AI applications, assess the tools,
    and plan adoption around their actual work. We look at where AI can help and where
    your team's judgment matters most.`,
    bullets: [
      'AI readiness assessments grounded in your current tools and workflows',
      '1:1 strategy sessions to sort through use cases and tool choices',
      'Implementation roadmaps with priorities and ways to evaluate results',
      'Ongoing advice as you test, learn, and refine your approach',
    ],
    outcome: 'The aim: a clear set of priorities and a practical path from experimenting with AI to using it in your day-to-day work.',
    cta: { href: '/book', label: 'Discuss Consulting' },
  },
  {
    id: 'speaking',
    label: '02 // speaking',
    title: 'AI Speaking & Keynotes',
    color: 'electric',
    description: `A clear signal for audiences sorting through AI noise. I speak about AI adoption,
    human judgment, and what these tools mean for the work people care about.
    Each talk connects that bigger picture to your audience's decisions,
    drawing on my experience shaping an AI assistant used by real businesses.`,
    bullets: [
      'Conference keynotes and panel appearances',
      'Corporate events and executive briefings',
      'Industry association engagements',
      'Custom talk development for your audience',
    ],
    outcome: 'The aim: a shared understanding of AI and better questions to bring back to the work, with concrete next steps for your audience.',
    cta: { href: '/book', label: 'Inquire About Speaking' },
  },
  {
    id: 'webinars',
    label: '03 // webinars',
    title: 'AI Training & Workshops',
    color: 'amber',
    description: `Get your hands on the dials. I design AI training, webinars, and workshops
    around the tasks your team actually does. We practice giving clear instructions,
    evaluating outputs, and fitting AI into a workflow without handing over the judgment.
    There's room to experiment, ask questions, and find what works for your group.`,
    bullets: [
      'Live AI webinars for teams, associations, and communities',
      'Interactive workshops, virtual or in person',
      'Custom exercises and curriculum built around your domain',
      'Cohort-based learning with space to practice and ask questions',
    ],
    outcome: 'The aim: useful techniques your team has practiced, a clearer sense of what to check, and workflows to keep developing after the session.',
    cta: { href: '/book', label: 'Discuss Team Training' },
  },
];
---

<BaseLayout
  title="AI Consulting, Workshops & Speaking"
  description="AI strategy consulting, hands-on team training, and speaking with Charles Wilke. Practical guidance for small and mid-sized businesses, based in Omaha."
>

  <!-- ── Page header ── -->
  <PageHero label="// what we offer" title="AI Consulting & Training" image={servicesHero} imageOpacity={0.55}>
    <p class="text-muted page-hero-sub">
      AI strategy, team workshops, and speaking, built around the work you want
      more time for. I'm Charles Wilke, based in Omaha. You work with me directly,
      starting with an exploratory conversation.
    </p>
  </PageHero>

  <section class="section conversation-section">
    <div class="container conversation-layout">
      <div class="conversation-heading">
        <div class="label">// first contact</div>
        <h2>Start with a conversation.</h2>
      </div>
      <div class="conversation-body">
        <p>
          A 30-minute conversation about your work, your team, and where you're
          getting stuck. We'll explore where AI could help and whether it makes
          sense to work together.
        </p>
        <p class="text-muted">
          From there, we can shape the next step: consulting, hands-on training,
          or a talk for your audience.
        </p>
        <a href="/book" class="btn btn-primary">Book an Exploratory Call</a>
      </div>
    </div>
  </section>

  <!-- ── Services ── -->
  {services.map((svc) => (
    <section id={svc.id} class="service-section section">
      <div class="container service-layout">

        <div class="service-meta">
          <div class="label" style={`color: var(--${svc.color === 'phosphor' ? 'phosphor' : svc.color === 'electric' ? 'electric' : 'amber'})`}>
            {svc.label}
          </div>
        </div>

        <div class="service-body">
          <h2>{svc.title}</h2>
          <p>{svc.description}</p>

          {svc.id === 'speaking' && (
            <figure class="speaking-photo">
              <Image
                src={charlesSpeaking}
                alt="Charles Wilke presenting Spectator to Initiator to a seated audience."
                widths={[480, 800, 1200]}
                sizes="(max-width: 959px) calc(100vw - 40px), 900px"
                format="webp"
                loading="lazy"
              />
              <figcaption>
                <span>// Spectator to Initiator</span>
                <a href="https://charleswilke.com/s2i" target="_blank" rel="noopener">View the talk deck ↗</a>
              </figcaption>
            </figure>
          )}

          <ul class="service-bullets">
            {svc.bullets.map(b => (
              <li>
                <span class={`bullet-mark text-${svc.color === 'phosphor' ? 'phosphor' : svc.color === 'electric' ? 'electric' : 'amber'}`}>▸</span>
                {b}
              </li>
            ))}
          </ul>

          <p>{svc.outcome}</p>

          {svc.id === 'webinars' && (
            <figure class="recommendation">
              <div class="label">// from a colleague</div>
              <blockquote>
                <p>
                  “He was always proactively experimenting … spearheading an AI
                  education project to ensure our entire team was up to date
                  and proficient in new tools.”
                </p>
              </blockquote>
              <figcaption>
                <span class="recommendation-name">Estella Aditirto</span>
                <span class="text-muted">Technical Writer, GoDaddy</span>
              </figcaption>
            </figure>
          )}

          <a href={svc.cta.href} class="btn btn-primary">{svc.cta.label}</a>
        </div>

      </div>
    </section>
  ))}

  <!-- ── CTA ── -->
  <section class="cta-section">
    <div class="cta-bg" aria-hidden="true">
      <Image src={patchbay} alt="" class="cta-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container cta-inner">
      <h2 class="text-phosphor glow-green">Let's find a useful next step.</h2>
      <p class="text-muted">Bring your questions and a task you'd like to make easier.<br />We'll start with a 30-minute exploratory conversation.</p>
      <div class="cta-buttons">
        <a href="/book" class="btn btn-primary">Book an Exploratory Call</a>
        <a href="mailto:cwilke@fellowvector.com" class="btn btn-ghost">Send an Email</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero-sub {
    font-size: 1rem;
    max-width: 55ch;
  }

  .conversation-section {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .conversation-layout {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--layout-gap);
    align-items: start;
  }

  .conversation-heading,
  .conversation-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .conversation-body .btn {
    align-self: flex-start;
    max-width: 100%;
    text-align: center;
  }

  .recommendation {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
    margin: var(--sp-md) 0;
    padding: var(--sp-lg);
    border: 1px solid var(--border);
    border-left: 2px solid var(--amber);
    background: var(--bg-surface);
  }

  .recommendation .label {
    color: var(--amber);
  }

  .recommendation figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    font-size: 0.85rem;
  }

  .recommendation-name {
    color: var(--amber);
  }

  @media (max-width: 768px) {
    .conversation-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-lg);
    }
  }

  .service-section + .service-section {
    border-top: 1px solid var(--border);
  }

  .service-layout {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: var(--layout-gap);
    align-items: start;
  }

  .service-meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding-top: var(--sp-sm);
    position: sticky;
    top: 80px;
  }

  .service-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .service-body h2 {
    margin-top: var(--sp-xs);
  }

  .speaking-photo {
    margin: var(--sp-sm) 0;
    border: 1px solid var(--electric-dim);
    background: var(--bg-surface);
  }

  .speaking-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .speaking-photo figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-sm) var(--sp-md);
    padding: var(--sp-md);
    border-top: 1px solid var(--electric-dim);
    color: var(--electric);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .speaking-photo figcaption a {
    color: var(--electric);
    text-underline-offset: 0.2em;
  }

  .service-body > .btn {
    align-self: flex-start;
    max-width: 100%;
    text-align: center;
  }

  .service-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    margin: var(--sp-sm) 0;
  }

  .service-bullets li {
    display: flex;
    gap: var(--sp-sm);
    align-items: baseline;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  .bullet-mark {
    flex-shrink: 0;
    font-size: 0.7rem;
  }

  .cta-section {
    position: relative;
    text-align: center;
    padding: var(--section-space) 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-top: 1px solid var(--border);
  }

  .cta-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .cta-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.28;
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      rgba(8, 9, 15, 0.3) 0%,
      rgba(8, 9, 15, 0.88) 100%
    );
  }

  .cta-buttons {
    display: flex;
    gap: var(--sp-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-md);
  }

  @media (max-width: 959px) {
    .service-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-md);
    }

    .service-meta {
      position: static;
      padding-top: 0;
    }

  }
</style>
