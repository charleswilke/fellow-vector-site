---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import splash from '../assets/splash.webp';
import focus from '../assets/focus.webp';
import signal from '../assets/signal.webp';
import bulb from '../assets/bulb.webp';
---

<BaseLayout
  title="AI Consulting & Team Training"
  description="Practical AI consulting, workflow design, and team training for small and mid-sized businesses. Work directly with Charles Wilke, based in Omaha."
>

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-label label">// incoming transmission</div>
      <h1 class="hero-headline glow-green text-phosphor">
        NAVIGATE<br />THE SIGNAL<span class="hero-cursor">_</span>
      </h1>
      <p class="hero-sub">
        I'm Charles Wilke, an Omaha-based AI consultant. I help small and
        mid-sized businesses find where AI fits, build useful workflows,
        and give their teams the confidence to use it. Less noise.
        More time for the work only you can do.
      </p>
      <div class="hero-cta">
        <a href="/services" class="btn btn-primary">Explore AI Services</a>
        <a href="/book" class="btn btn-ghost">Book a Call</a>
      </div>
    </div>

    <div class="hero-bg" aria-hidden="true">
      <Image
        src={splash}
        alt=""
        class="hero-splash"
        widths={[480, 800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- ── Signal strip ── -->
  <!-- 4 copies so seam is always off-screen; animation travels -25% = exactly one copy width -->
  <div class="signal-strip" aria-hidden="true">
    <div class="signal-ticker">
      <span>CONSULTING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>WEBINARS</span><span class="sep">///</span><span>STRATEGY</span><span class="sep">///</span><span>AI ADOPTION</span><span class="sep">///</span><span>LEADERSHIP</span><span class="sep">///</span>
      <span>CONSULTING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>WEBINARS</span><span class="sep">///</span><span>STRATEGY</span><span class="sep">///</span><span>AI ADOPTION</span><span class="sep">///</span><span>LEADERSHIP</span><span class="sep">///</span>
      <span>CONSULTING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>WEBINARS</span><span class="sep">///</span><span>STRATEGY</span><span class="sep">///</span><span>AI ADOPTION</span><span class="sep">///</span><span>LEADERSHIP</span><span class="sep">///</span>
      <span>CONSULTING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>WEBINARS</span><span class="sep">///</span><span>STRATEGY</span><span class="sep">///</span><span>AI ADOPTION</span><span class="sep">///</span><span>LEADERSHIP</span><span class="sep">///</span>
    </div>
  </div>

  <!-- ── What we do ── -->
  <section class="section focus-section">
    <div class="focus-bg" aria-hidden="true">
      <Image src={focus} alt="" class="focus-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container">
      <div class="section-head">
        <div class="label">// services offered</div>
        <h2>Where do you need focus?</h2>
        <p class="text-muted">
          An AI strategy you can act on. A team that knows how to use the tools.
          A talk that makes the next step clearer. Pick the channel.
        </p>
      </div>

      <div class="services-grid">
        <a href="/services#consulting" class="card service-card">
          <div class="service-icon text-phosphor">▸▸</div>
          <h3>AI Strategy & Consulting</h3>
          <p class="text-muted">
            Find the work AI can help with, choose tools that fit, and build
            a plan for putting them to use. For founders, operators, and teams
            who want a strategy they understand and own.
          </p>
          <span class="card-arrow text-phosphor">→</span>
        </a>

        <a href="/services#speaking" class="card service-card">
          <div class="service-icon text-electric">▸▸</div>
          <h3>AI Speaking & Keynotes</h3>
          <p class="text-muted">
            Talks on AI adoption, human judgment, and meaningful work for
            conferences and leadership teams. Grounded in practice,
            with a clear connection to your audience's work.
          </p>
          <span class="card-arrow text-electric">→</span>
        </a>

        <a href="/services#webinars" class="card service-card">
          <div class="service-icon text-amber">▸▸</div>
          <h3>AI Training & Workshops</h3>
          <p class="text-muted">
            Hands-on AI training built around your team's tasks. Practice
            giving useful instructions, checking results, and building
            workflows you can take back to work.
          </p>
          <span class="card-arrow text-amber">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Why Fellow Vector ── -->
  <section class="section alt-section">
    <div class="container why-grid">
      <div class="why-text">
        <div class="label">// the frequency</div>
        <h2>Signal over noise.</h2>
        <p>
          Most of the AI conversation right now is noise. Alarmists on one channel,
          breathless optimists on the other, static everywhere in between.
        </p>
        <p>
          At Toast, I design Toast IQ's top-level system instructions: the guidance
          that shapes how the AI assistant responds and acts. That's the vantage
          point Fellow Vector broadcasts from. Real tools, in real use.
        </p>
        <p>
          The goal is to help you find the time you've been missing. Time for the work that lights you up, the thinking
          that moves your business forward, the stuff that keeps getting crowded out.
        </p>
        <p>
          Through Fellow Vector, you work with me directly. We look at your tasks,
          your tools, and where human judgment needs to stay in the loop. Then we
          work out what to try, what to check, and how to tell whether it's helping.
        </p>
        <a href="/about" class="btn btn-ghost" style="margin-top: 1.5rem;">About Fellow Vector</a>
      </div>

      <div class="why-stats">
        <div class="stat-block">
          <div class="stat-number text-phosphor glow-green">01</div>
          <div class="stat-label">Strategic clarity over buzzword compliance</div>
        </div>
        <div class="stat-block">
          <div class="stat-number text-electric glow-blue">02</div>
          <div class="stat-label">Grounded in practice, not prediction</div>
        </div>
        <div class="stat-block">
          <div class="stat-number text-amber">03</div>
          <div class="stat-label">Focused on giving you your time back</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta-section">
    <div class="cta-bg" aria-hidden="true">
      <Image src={signal} alt="" class="cta-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="cta-bulb" aria-hidden="true">
      <Image src={bulb} alt="" widths={[400, 640]} sizes="(max-width: 768px) 200px, 320px" loading="lazy" />
    </div>
    <div class="container cta-inner">
      <h2 class="text-phosphor glow-green">What's keeping you from the work that brings you joy?</h2>
      <p class="text-muted">
        Let's find out what AI can take off your plate.<br />You get to decide what you'll do with the time back.
      </p>
      <div class="cta-buttons">
        <a href="/book" class="btn btn-primary">Book a Call</a>
        <a href="mailto:cwilke@fellowvector.com" class="btn btn-ghost">Send an Email</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: calc(100vh - 64px);
    min-height: calc(100svh - 64px); /* mobile: don't overshoot the visible area under the toolbar */
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    opacity: 0.55;
  }

  /* Gradient: dark on the left where text lives, fades toward image on the right */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right,
        var(--bg) 20%,
        rgba(8, 9, 15, 0.75) 50%,
        rgba(8, 9, 15, 0.2) 100%
      ),
      linear-gradient(to top,
        var(--bg) 0%,
        transparent 30%
      );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
    padding-top: var(--sp-2xl);
    padding-bottom: var(--sp-2xl);
  }

  .hero-label { animation: fadeIn 0.6s 0.2s both; }
  .hero-headline { animation: fadeIn 0.7s 0.35s both; line-height: 1; }

  .hero-cursor {
    display: inline-block;
    margin-left: 0.05em;
    animation: blink 4.2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .hero-sub {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    color: var(--fg-muted);
    max-width: 52ch;
    animation: fadeIn 0.7s 0.5s both;
  }
  .hero-cta {
    display: flex;
    gap: var(--sp-md);
    flex-wrap: wrap;
    animation: fadeIn 0.7s 0.65s both;
  }

  /* ── Signal strip ── */
  .signal-strip {
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.6rem 0;
    background: var(--bg-surface);
  }

  .signal-ticker {
    display: flex;
    gap: 2rem;
    white-space: nowrap;
    animation: ticker 22s linear infinite;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--fg-muted);
    width: max-content;
    will-change: transform;
    backface-visibility: hidden;
  }

  .signal-ticker .sep {
    color: var(--phosphor-dim);
    opacity: 0.5;
  }

  @keyframes ticker {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-25%, 0, 0); }
  }

  /* ── Focus / services section ── */
  .focus-section {
    position: relative;
    overflow: hidden;
  }

  .focus-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .focus-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.18;
  }

  .focus-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(8, 9, 15, 0.2) 0%,
      rgba(8, 9, 15, 0.8) 100%
    );
  }

  .focus-section .container {
    position: relative;
    z-index: 1;
  }

  /* ── Services grid ── */
  .section-head {
    margin-bottom: var(--sp-xl);
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .section-head h2 { margin-top: var(--sp-xs); }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-md);
  }

  .service-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding: var(--sp-lg) var(--sp-lg) var(--sp-md);
  }

  .service-card h3 { color: var(--fg); transition: color 0.2s; }
  .service-card:hover h3 { color: var(--phosphor); }

  .service-icon {
    font-family: var(--font-crt);
    font-size: 1.2rem;
    letter-spacing: -0.05em;
  }

  .card-arrow {
    font-size: 1.2rem;
    margin-top: auto;
    padding-top: var(--sp-sm);
    transition: transform 0.2s;
    align-self: flex-start;
  }

  .service-card:hover .card-arrow { transform: translateX(6px); }

  /* ── Why / alt section ── */
  .alt-section {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2xl);
    align-items: start;
  }

  .why-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .why-stats {
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
    padding-top: 2.5rem;
  }

  .stat-block {
    display: flex;
    align-items: baseline;
    gap: var(--sp-md);
    border-left: 1px solid var(--border);
    padding-left: var(--sp-md);
  }

  .stat-number {
    font-family: var(--font-crt);
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
  }

  /* ── CTA ── */
  .cta-section {
    position: relative;
    text-align: center;
    padding: var(--sp-2xl) 0;
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.12;
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(8, 9, 15, 0.3) 0%,
      rgba(8, 9, 15, 0.85) 100%
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-lg);
    max-width: 60%;
    margin: 0 auto;
  }

  .cta-bulb {
    position: absolute;
    right: 5%;
    bottom: -15%;
    top: auto;
    transform: none;
    width: 320px;
    mix-blend-mode: screen;
  }

  .cta-bulb img {
    width: 100%;
    height: auto;
    display: block;
  }

  .cta-buttons {
    display: flex;
    gap: var(--sp-md);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .cta-inner {
      max-width: 100%;
      align-items: center;
      text-align: center;
    }

    .cta-buttons {
      justify-content: center;
    }

    .cta-bulb {
      position: absolute;
      right: 50%;
      transform: translateX(50%);
      bottom: -12%;
      top: auto;
      width: 200px;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-xl);
    }
  }
</style>

