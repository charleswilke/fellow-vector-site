---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import focus from '../assets/focus.webp';
import signal from '../assets/signal.webp';
import bulb from '../assets/cw-bulb-amber.webp';
import floppyDisk from '../assets/floppy-disk-note-v1.webp';
import floppyLabel from '../assets/floppy-label.webp';
import illustratedPortrait from '../assets/cw4.webp';
import photoPortrait from '../assets/cw2.webp';
---

<BaseLayout
  title="AI Tutoring & Capacity Building"
  description="Hands-on AI tutoring for individuals and teams. Build skills around your role, from everyday tasks to business applications, with Charles Wilke in Omaha."
>

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow"><span>Another tech wave. Another thing you’re supposed to know.</span></p>
        <h1 class="hero-headline glow-phosphor text-phosphor">
          LEARN BY DOING<span class="hero-cursor">_</span>
        </h1>
        <p class="hero-tagline">Practical AI skills for your everyday work.</p>
        <p class="hero-sub">
          I offer one-to-one AI tutoring and hands-on workshops for teams.
          Learn to use AI on real tasks, from writing and research to
          building your own reusable workflows.
        </p>
        <div class="hero-cta">
          <a href="/services" class="btn btn-primary"><span class="hero-primary-label">Find Your Starting Point</span></a>
          <a href="/book" class="btn btn-ghost">Book a Call</a>
        </div>
      </div>
      <div class="hero-welcome">
        <aside class="tutor-note" aria-label="A note from Charles">
          <picture class="tutor-note-surface">
            <source media="(max-width: 760px)" srcset={floppyLabel.src} type="image/webp" />
            <Image
              src={floppyDisk}
              alt=""
              class="tutor-note-disk"
              widths={[400, 640, 880, 1100]}
              sizes="(max-width: 1100px) 45vw, 480px"
              loading="eager"
            />
          </picture>
          <div class="tutor-note-copy">
            <div class="tutor-note-message">
              <p>Bring a question or something you’re working on. We’ll figure out where to start together.</p>
              <div class="tutor-note-signature">
                <span>Charles Wilke</span>
                <span>Writer // Designer // AI tutor</span>
              </div>
            </div>
            <Image
              src={illustratedPortrait}
              alt="Illustration of Charles Wilke"
              class="tutor-note-portrait"
              widths={[160, 240, 320]}
              sizes="(max-width: 760px) 102px, (max-width: 1100px) 12vw, 140px"
              loading="eager"
            />
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ── Signal strip ── -->
  <!-- 4 copies so seam is always off-screen; animation travels -25% = exactly one copy width -->
  <div class="signal-strip" aria-hidden="true">
    <div class="signal-ticker">
      <span>AI TUTORING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>HANDS-ON LEARNING</span><span class="sep">///</span><span>YOUR ROLE</span><span class="sep">///</span><span>CAPACITY BUILDING</span><span class="sep">///</span><span>HUMAN JUDGMENT</span><span class="sep">///</span>
      <span>AI TUTORING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>HANDS-ON LEARNING</span><span class="sep">///</span><span>YOUR ROLE</span><span class="sep">///</span><span>CAPACITY BUILDING</span><span class="sep">///</span><span>HUMAN JUDGMENT</span><span class="sep">///</span>
      <span>AI TUTORING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>HANDS-ON LEARNING</span><span class="sep">///</span><span>YOUR ROLE</span><span class="sep">///</span><span>CAPACITY BUILDING</span><span class="sep">///</span><span>HUMAN JUDGMENT</span><span class="sep">///</span>
      <span>AI TUTORING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>HANDS-ON LEARNING</span><span class="sep">///</span><span>YOUR ROLE</span><span class="sep">///</span><span>CAPACITY BUILDING</span><span class="sep">///</span><span>HUMAN JUDGMENT</span><span class="sep">///</span>
    </div>
  </div>

  <!-- ── What we do ── -->
  <section class="section focus-section">
    <div class="focus-bg" aria-hidden="true">
      <Image src={focus} alt="" class="focus-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container">
      <div class="focus-intro">
        <div class="section-head">
          <h2>Build your capacity.</h2>
          <p class="text-muted">
            Start with a question, a task, or something you want to make.
            Learn one-to-one, practice with your team, or bring the conversation
            to a room full of curious people.
          </p>
        </div>
        <figure class="focus-character">
          <Image
            src={bulb}
            alt="Charles’s friendly amber CW lightbulb character"
            widths={[240, 400, 600]}
            sizes="(max-width: 600px) 180px, (max-width: 1100px) 25vw, 300px"
            loading="lazy"
          />
        </figure>
      </div>

      <div class="services-grid">
        <a href="/services#consulting" class="card service-card">
          <div class="service-icon text-phosphor">▸▸</div>
          <h3>One-to-One AI Tutoring</h3>
          <p class="text-muted">
            Bring your own work and questions. Learn to use AI, check its
            output, and build something useful at a pace that fits you.
          </p>
          <span class="card-arrow text-phosphor">→</span>
        </a>

        <a href="/services#speaking" class="card service-card">
          <div class="service-icon text-electric">▸▸</div>
          <h3>AI Speaking & Keynotes</h3>
          <p class="text-muted">
            A practical conversation about AI, human judgment, and the
            possibilities people can explore in their own work.
          </p>
          <span class="card-arrow text-electric">→</span>
        </a>

        <a href="/services#webinars" class="card service-card">
          <div class="service-icon text-amber">▸▸</div>
          <h3>Role-Focused Workshops</h3>
          <p class="text-muted">
            Build skills around the work your team knows best. Practice
            together, from everyday workflows to business applications.
          </p>
          <span class="card-arrow text-amber">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Why Fellow Vector ── -->
  <section class="section alt-section">
    <div class="container why-grid">
      <figure class="operator-portrait">
        <div class="portrait-frame">
          <Image
            src={photoPortrait}
            alt="Charles Wilke"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 240px, 320px"
            loading="lazy"
          />
          <span class="portrait-corner tl" aria-hidden="true"></span>
          <span class="portrait-corner tr" aria-hidden="true"></span>
          <span class="portrait-corner bl" aria-hidden="true"></span>
          <span class="portrait-corner br" aria-hidden="true"></span>
        </div>
        <figcaption>
          <span class="label">// the operator</span>
          <span class="portrait-name">Charles Wilke</span>
          <span class="text-muted">Writer. Designer. AI tutor.</span>
        </figcaption>
      </figure>

      <div class="why-text">
        <h2>A familiar place to begin.</h2>
        <p>
          At Toast, I design Toast IQ's top-level system instructions: the guidance
          that shapes how the AI assistant responds and acts. My perspective
          comes from working on tools people use every day.
        </p>
        <p>
          If you grew up with an Apple II, Math Blaster, or The Oregon Trail,
          this glow might feel familiar. I call it the C-prompt lifestyle:
          try something, see what happens, and learn your way forward.
          You're welcome here even if your first screen looked different.
        </p>
        <p>
          Through Fellow Vector, I bring that spirit to learning AI.
          I'm here to help people build capacity in their own roles.
          Automation should give employees more agency, more room for their
          craft, and a say in how their work changes.
        </p>
        <a href="/about" class="btn btn-ghost">More About Charles</a>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta-section">
    <div class="cta-bg" aria-hidden="true">
      <Image src={signal} alt="" class="cta-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container cta-inner">
      <h2 class="text-phosphor glow-phosphor">What would you like to learn to do?</h2>
      <p class="text-muted">
        Bring a question, a recurring task, or an idea you've been meaning to try.
      </p>
      <div class="cta-buttons">
        <a href="/book" class="btn btn-primary">Book a Call</a>
        <a href="mailto:cwilke@fellowvector.com" class="btn btn-ghost">Send an Email</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section,
  .cta-section {
    padding: var(--section-space) 0;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .hero-copy {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.6rem);
    min-width: 0;
  }

  .hero-eyebrow {
    width: 100%;
    max-width: 100%;
    padding-block: 0.1rem;
    border-block: 1px solid var(--border-hover);
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    animation: fadeIn 0.7s 0.2s both;
  }

  .hero-eyebrow span {
    position: relative;
    top: 1px;
  }

  .hero-headline {
    font-size: clamp(1.75rem, 14cqi, 4.75rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    white-space: nowrap;
    animation: fadeIn 0.7s 0.35s both;
  }

  .hero-welcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 30rem;
    min-width: 0;
    justify-self: end;
    align-self: center;
  }

  .tutor-note {
    container-type: inline-size;
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1;
    transform: rotate(-2deg);
    filter: drop-shadow(0 12px 16px rgba(12, 8, 4, 0.25));
  }

  @media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
    .tutor-note {
      animation: tutor-note-float 8s ease-in-out infinite;
    }
  }

  @keyframes tutor-note-float {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-6px) rotate(-1.5deg); }
  }

  .tutor-note-surface {
    position: absolute;
    inset: 0;
    display: block;
  }

  .tutor-note-disk {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tutor-note-copy {
    position: absolute;
    top: 13%;
    left: 10.5%;
    width: 78%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30%;
    align-items: center;
    gap: 3%;
    color: #382414;
  }

  .tutor-note-portrait {
    display: block;
    width: 100%;
    height: auto;
    transform: scale(1.15);
    mix-blend-mode: multiply;
    mask-image: radial-gradient(ellipse at center, #000 55%, transparent 76%);
  }

  .tutor-note p { font-size: clamp(0.75rem, 3.5cqi, 1rem); line-height: 1.25; }

  .tutor-note p,
  .tutor-note-signature {
    position: relative;
    top: 0.3rem;
  }

  .tutor-note-signature {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 1.1cqi;
    font-size: clamp(0.625rem, 2.6cqi, 0.75rem);
    line-height: 1.2;
    text-align: right;
    translate: 0 -0.3rem;
    color: #664a30;
  }

  .tutor-note-signature span:first-child { color: #382414; }

  @media (min-width: 761px) {
    .tutor-note p,
    .tutor-note-signature { top: calc(0.3rem - 3px); }
  }

  @media (min-width: 761px) and (max-width: 1000px) {
    .tutor-note-copy { grid-template-columns: minmax(0, 1fr) 26%; gap: 2%; }
    .tutor-note-portrait { transform: scale(1.325); }
  }

  @media (max-width: 760px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.5rem;
    }
    .hero-welcome { justify-self: center; margin-top: 0; }
    .tutor-note {
      aspect-ratio: auto;
      min-height: 13rem;
      padding: 5rem 1.5rem 3.5rem;
    }
    .tutor-note-copy {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      grid-template-columns: minmax(0, 1fr) clamp(3.5rem, calc(40cqi - 2.25rem), 5.5rem);
      gap: 0.375rem 0.5rem;
    }
    .tutor-note-message { display: contents; }
    .tutor-note p {
      grid-column: 1 / -1;
      grid-row: 1;
      font-size: clamp(0.875rem, 3.4cqi, 1rem);
      line-height: 1.35;
      text-wrap: pretty;
      top: 0;
    }
    .tutor-note-portrait {
      grid-column: 2;
      grid-row: 2;
    }
    .tutor-note-signature {
      grid-column: 1;
      grid-row: 2;
      margin-top: 0;
      font-size: clamp(0.6875rem, 4.5cqi, 0.75rem);
      line-height: 1.25;
      top: 0;
      translate: none;
    }
  }

  .hero-cursor {
    display: inline-block;
    margin-left: 0.05em;
    animation: blink 4.2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .hero-tagline {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.4;
    color: var(--fg);
    animation: fadeIn 0.7s 0.5s both;
  }

  .hero-sub {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    line-height: 1.65;
    color: var(--fg-muted);
    max-width: 52ch;
    animation: fadeIn 0.7s 0.5s both;
  }
  .hero-cta {
    display: flex;
    width: 100%;
    gap: 0.75rem;
    align-items: stretch;
    animation: fadeIn 0.7s 0.65s both;
  }

  .hero-cta .btn {
    --btn-inline-space: clamp(0.75rem, 1.5vw, 1.5rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    text-align: center;
    letter-spacing: 0.08em;
  }

  .hero-cta .btn-ghost { flex-shrink: 0; white-space: nowrap; }

  .hero-cta .btn-primary {
    padding-inline: calc(var(--btn-inline-space) + 0.625em);
  }

  .hero-primary-label { transition: transform 0.15s ease-out; }

  .hero-cta .btn-primary:is(:hover, :focus-visible) .hero-primary-label {
    transform: translateX(-0.625em);
  }

  /* ── Signal strip ── */
  .signal-strip {
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.6rem 0;
    background: var(--bg-surface);
  }

  .signal-ticker {
    display: flex;
    gap: 2rem;
    white-space: nowrap;
    animation: ticker 22s linear infinite;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--fg-muted);
    width: max-content;
    will-change: transform;
    backface-visibility: hidden;
  }

  .signal-ticker .sep {
    color: var(--phosphor-dim);
    opacity: 0.5;
  }

  @keyframes ticker {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-25%, 0, 0); }
  }

  /* ── Focus / services section ── */
  .focus-section {
    position: relative;
    overflow: hidden;
  }

  .focus-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .focus-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.08;
  }

  .focus-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(var(--bg-rgb), 0.2) 0%,
      rgba(var(--bg-rgb), 0.8) 100%
    );
  }

  .focus-section .container {
    position: relative;
    z-index: 1;
  }

  .focus-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(180px, 25vw, 300px);
    align-items: end;
    gap: var(--layout-gap);
  }

  .focus-character {
    width: 100%;
    height: clamp(170px, 19vw, 220px);
    overflow: hidden;
    pointer-events: none;
  }

  .focus-character img {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(-12deg);
    transform-origin: 50% 60%;
  }

  @media (max-width: 600px) {
    .focus-intro { display: block; }
    .focus-intro .section-head { margin-bottom: 0; }
    .focus-character {
      width: 180px;
      height: 125px;
      margin-left: auto;
    }
  }

  /* ── Services grid ── */
  .section-head {
    margin-bottom: var(--sp-lg);
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .services-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-md);
  }

  .service-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding: var(--sp-lg) var(--sp-lg) var(--sp-md);
  }

  .service-card h3 { color: var(--fg); transition: color 0.2s; }
  .service-card:hover h3 { color: var(--phosphor); }

  .service-icon {
    font-family: var(--font-crt);
    font-size: 1.2rem;
    letter-spacing: -0.05em;
  }

  .card-arrow {
    font-size: 1.2rem;
    margin-top: auto;
    padding-top: var(--sp-sm);
    transition: transform 0.2s;
    align-self: flex-start;
  }

  .service-card:hover .card-arrow { transform: translateX(6px); }

  @media (max-width: 959px) {
    .services-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .service-card {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr) 1.5rem;
      gap: var(--sp-sm) var(--sp-md);
      padding: 1.25rem 1.5rem;
      align-items: baseline;
    }

    .service-icon {
      grid-column: 1;
      grid-row: 1;
    }

    .service-card h3 {
      grid-column: 2;
      grid-row: 1;
    }

    .service-card p {
      grid-column: 2;
      grid-row: 2;
    }

    .card-arrow {
      grid-column: 3;
      grid-row: 1 / 3;
      margin: 0;
      padding: 0;
      align-self: center;
    }
  }

  @media (max-width: 600px) {
    .service-card {
      padding: 1.25rem;
      column-gap: 0.75rem;
    }

    .service-card p {
      grid-column: 1 / -1;
    }

    .card-arrow {
      grid-row: 1;
    }
  }

  /* ── Why / alt section ── */
  .alt-section {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--sp-xl);
    align-items: center;
  }

  .why-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .why-text .btn {
    align-self: flex-start;
    margin-top: var(--sp-sm);
  }

  .operator-portrait {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .portrait-frame {
    position: relative;
    border: 1px solid var(--phosphor-dim);
    padding: var(--sp-sm);
    background: var(--bg);
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .portrait-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--phosphor);
    border-style: solid;
    border-width: 0;
  }

  .portrait-corner.tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
  .portrait-corner.tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
  .portrait-corner.bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
  .portrait-corner.br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

  .operator-portrait figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    font-size: 0.85rem;
  }

  .portrait-name {
    font-family: var(--font-crt);
    font-size: 1.8rem;
    line-height: 1.15;
    letter-spacing: 0.04em;
  }

  /* ── CTA ── */
  .cta-section {
    position: relative;
    text-align: center;
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.12;
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(var(--bg-rgb), 0.3) 0%,
      rgba(var(--bg-rgb), 0.85) 100%
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-lg);
    max-width: 60%;
    margin: 0 auto;
  }

  .cta-buttons {
    display: flex;
    gap: var(--sp-md);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .cta-inner {
