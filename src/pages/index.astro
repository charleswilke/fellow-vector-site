---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import splash from '../assets/splash.webp';
import focus from '../assets/focus.webp';
import signal from '../assets/signal.webp';
import bulb from '../assets/bulb.webp';
import portrait from '../assets/cw4.webp';
---

<BaseLayout
  title="AI Tutoring & Capacity Building"
  description="Hands-on AI tutoring for individuals and teams. Build skills around your role, from everyday tasks to business applications, with Charles Wilke in Omaha."
>

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-label label">C:\&gt; ready when you are</div>
      <h1 class="hero-headline glow-phosphor text-phosphor">
        LEARN BY<br />DOING<span class="hero-cursor">_</span>
      </h1>
      <p class="hero-sub">
        AI driver's ed for your everyday work. Learn the tools, practice on
        real tasks, and build the judgment to stay in the driver's seat.
      </p>
      <div class="hero-cta">
        <a href="/services" class="btn btn-primary">Find Your Starting Point</a>
        <a href="/book" class="btn btn-ghost">Book a Call</a>
      </div>
    </div>

    <div class="hero-bg" aria-hidden="true">
      <Image
        src={splash}
        alt=""
        class="hero-splash"
        widths={[480, 800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- ── Signal strip ── -->
  <!-- 4 copies so seam is always off-screen; animation travels -25% = exactly one copy width -->
  <div class="signal-strip" aria-hidden="true">
    <div class="signal-ticker">
      <span>AI TUTORING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>HANDS-ON LEARNING</span><span class="sep">///</span><span>YOUR ROLE</span><span class="sep">///</span><span>CAPACITY BUILDING</span><span class="sep">///</span><span>HUMAN JUDGMENT</span><span class="sep">///</span>
      <span>AI TUTORING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>HANDS-ON LEARNING</span><span class="sep">///</span><span>YOUR ROLE</span><span class="sep">///</span><span>CAPACITY BUILDING</span><span class="sep">///</span><span>HUMAN JUDGMENT</span><span class="sep">///</span>
      <span>AI TUTORING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>HANDS-ON LEARNING</span><span class="sep">///</span><span>YOUR ROLE</span><span class="sep">///</span><span>CAPACITY BUILDING</span><span class="sep">///</span><span>HUMAN JUDGMENT</span><span class="sep">///</span>
      <span>AI TUTORING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>HANDS-ON LEARNING</span><span class="sep">///</span><span>YOUR ROLE</span><span class="sep">///</span><span>CAPACITY BUILDING</span><span class="sep">///</span><span>HUMAN JUDGMENT</span><span class="sep">///</span>
    </div>
  </div>

  <!-- ── What we do ── -->
  <section class="section focus-section">
    <div class="focus-bg" aria-hidden="true">
      <Image src={focus} alt="" class="focus-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container">
      <div class="section-head">
        <div class="label">// ways to learn</div>
        <h2>Build your capacity.</h2>
        <p class="text-muted">
          Start with a question, a task, or something you want to make.
          Learn one-to-one, practice with your team, or bring the conversation
          to a room full of curious people.
        </p>
      </div>

      <div class="services-grid">
        <a href="/services#consulting" class="card service-card">
          <div class="service-icon text-phosphor">▸▸</div>
          <h3>One-to-One AI Tutoring</h3>
          <p class="text-muted">
            Bring your own work and questions. Learn to use AI, check its
            output, and build something useful at a pace that fits you.
          </p>
          <span class="card-arrow text-phosphor">→</span>
        </a>

        <a href="/services#speaking" class="card service-card">
          <div class="service-icon text-electric">▸▸</div>
          <h3>AI Speaking & Keynotes</h3>
          <p class="text-muted">
            A practical conversation about AI, human judgment, and the
            possibilities people can explore in their own work.
          </p>
          <span class="card-arrow text-electric">→</span>
        </a>

        <a href="/services#webinars" class="card service-card">
          <div class="service-icon text-amber">▸▸</div>
          <h3>Role-Focused Workshops</h3>
          <p class="text-muted">
            Build skills around the work your team knows best. Practice
            together, from everyday workflows to business applications.
          </p>
          <span class="card-arrow text-amber">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Why Fellow Vector ── -->
  <section class="section alt-section">
    <div class="container why-grid">
      <figure class="operator-portrait">
        <div class="portrait-frame">
          <Image
            src={portrait}
            alt="Illustrated portrait of Charles Wilke"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 240px, 320px"
            loading="lazy"
          />
          <span class="portrait-corner tl" aria-hidden="true"></span>
          <span class="portrait-corner tr" aria-hidden="true"></span>
          <span class="portrait-corner bl" aria-hidden="true"></span>
          <span class="portrait-corner br" aria-hidden="true"></span>
        </div>
        <figcaption>
          <span class="label">// the operator</span>
          <span class="portrait-name">Charles Wilke</span>
          <span class="text-muted">Writer. Designer. AI tutor.</span>
        </figcaption>
      </figure>

      <div class="why-text">
        <div class="label">// the frequency</div>
        <h2>A familiar place to begin.</h2>
        <p>
          At Toast, I design Toast IQ's top-level system instructions: the guidance
          that shapes how the AI assistant responds and acts. My perspective
          comes from working on tools people use every day.
        </p>
        <p>
          If you grew up with an Apple II, Math Blaster, or The Oregon Trail,
          this glow might feel familiar. I call it the C-prompt lifestyle:
          try something, see what happens, and learn your way forward.
          You're welcome here even if your first screen looked different.
        </p>
        <p>
          Through Fellow Vector, I bring that spirit to learning AI.
          I'm here to help people build capacity in their own roles.
          Automation should give employees more agency, more room for their
          craft, and a say in how their work changes.
        </p>
        <a href="/about" class="btn btn-ghost">More About Charles</a>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta-section">
    <div class="cta-bg" aria-hidden="true">
      <Image src={signal} alt="" class="cta-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="cta-bulb" aria-hidden="true">
      <Image src={bulb} alt="" widths={[400, 640]} sizes="(max-width: 768px) 200px, 320px" loading="lazy" />
    </div>
    <div class="container cta-inner">
      <h2 class="text-phosphor glow-phosphor">What would you like to learn to do?</h2>
      <p class="text-muted">
        Bring a question, a recurring task, or an idea you've been meaning to try.
      </p>
      <div class="cta-buttons">
        <a href="/book" class="btn btn-primary">Book a Call</a>
        <a href="mailto:cwilke@fellowvector.com" class="btn btn-ghost">Send an Email</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section,
  .cta-section {
    padding: var(--section-space) 0;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: clamp(26rem, 70vh, 38rem);
    min-height: clamp(26rem, 70svh, 38rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    opacity: 0.55;
  }

  /* Gradient: dark on the left where text lives, fades toward image on the right */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right,
        var(--bg) 20%,
        rgba(16, 13, 9, 0.75) 50%,
        rgba(16, 13, 9, 0.2) 100%
      ),
      linear-gradient(to top,
        var(--bg) 0%,
        transparent 30%
      );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, var(--sp-lg));
    padding-top: var(--section-space);
    padding-bottom: var(--section-space);
  }

  .hero-label { animation: fadeIn 0.6s 0.2s both; }
  .hero-headline { animation: fadeIn 0.7s 0.35s both; line-height: 1; }

  .hero-cursor {
    display: inline-block;
    margin-left: 0.05em;
    animation: blink 4.2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .hero-sub {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    color: var(--fg-muted);
    max-width: 52ch;
    animation: fadeIn 0.7s 0.5s both;
  }
  .hero-cta {
    display: flex;
    gap: var(--sp-md);
    flex-wrap: wrap;
    animation: fadeIn 0.7s 0.65s both;
  }

  /* ── Signal strip ── */
  .signal-strip {
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.6rem 0;
    background: var(--bg-surface);
  }

  .signal-ticker {
    display: flex;
    gap: 2rem;
    white-space: nowrap;
    animation: ticker 22s linear infinite;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--fg-muted);
    width: max-content;
    will-change: transform;
    backface-visibility: hidden;
  }

  .signal-ticker .sep {
    color: var(--phosphor-dim);
    opacity: 0.5;
  }

  @keyframes ticker {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-25%, 0, 0); }
  }

  /* ── Focus / services section ── */
  .focus-section {
    position: relative;
    overflow: hidden;
  }

  .focus-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .focus-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.18;
  }

  .focus-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(16, 13, 9, 0.2) 0%,
      rgba(16, 13, 9, 0.8) 100%
    );
  }

  .focus-section .container {
    position: relative;
    z-index: 1;
  }

  /* ── Services grid ── */
  .section-head {
    margin-bottom: var(--sp-lg);
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .section-head h2 { margin-top: var(--sp-xs); }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-md);
  }

  .service-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding: var(--sp-lg) var(--sp-lg) var(--sp-md);
  }

  .service-card h3 { color: var(--fg); transition: color 0.2s; }
  .service-card:hover h3 { color: var(--phosphor); }

  .service-icon {
    font-family: var(--font-crt);
    font-size: 1.2rem;
    letter-spacing: -0.05em;
  }

  .card-arrow {
    font-size: 1.2rem;
    margin-top: auto;
    padding-top: var(--sp-sm);
    transition: transform 0.2s;
    align-self: flex-start;
  }

  .service-card:hover .card-arrow { transform: translateX(6px); }

  @media (max-width: 959px) {
    .services-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .service-card {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr) 1.5rem;
      gap: var(--sp-sm) var(--sp-md);
      padding: 1.25rem 1.5rem;
      align-items: baseline;
    }

    .service-icon {
      grid-column: 1;
      grid-row: 1;
    }

    .service-card h3 {
      grid-column: 2;
      grid-row: 1;
    }

    .service-card p {
      grid-column: 2;
      grid-row: 2;
    }

    .card-arrow {
      grid-column: 3;
      grid-row: 1 / 3;
      margin: 0;
      padding: 0;
      align-self: center;
    }
  }

  @media (max-width: 600px) {
    .service-card {
      padding: 1.25rem;
      column-gap: 0.75rem;
    }

    .service-card p {
      grid-column: 1 / -1;
    }

    .card-arrow {
      grid-row: 1;
    }
  }

  /* ── Why / alt section ── */
  .alt-section {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--sp-xl);
    align-items: center;
  }

  .why-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .why-text .btn {
    align-self: flex-start;
    margin-top: var(--sp-sm);
  }

  .operator-portrait {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .portrait-frame {
    position: relative;
    border: 1px solid var(--phosphor-dim);
    padding: var(--sp-sm);
    background: var(--bg);
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .portrait-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--phosphor);
    border-style: solid;
    border-width: 0;
  }

  .portrait-corner.tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
  .portrait-corner.tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
  .portrait-corner.bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
  .portrait-corner.br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

  .operator-portrait figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    font-size: 0.85rem;
  }

  .portrait-name {
    font-family: var(--font-crt);
    font-size: 1.8rem;
    line-height: 1.15;
    letter-spacing: 0.04em;
  }

  /* ── CTA ── */
  .cta-section {
    position: relative;
    text-align: center;
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.12;
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(16, 13, 9, 0.3) 0%,
      rgba(16, 13, 9, 0.85) 100%
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-lg);
    max-width: 60%;
    margin: 0 auto;
  }

  .cta-bulb {
    position: absolute;
    right: 5%;
    bottom: -15%;
    top: auto;
    transform: none;
    width: 320px;
    mix-blend-mode: screen;
  }

  .cta-bulb img {
    width: 100%;
    height: auto;
    display: block;
  }

  .cta-buttons {
    display: flex;
    gap: var(--sp-md);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .cta-inner {
      max-width: 100%;
      align-items: center;
      text-align: center;
    }

    .cta-buttons {
      justify-content: center;
    }

    .cta-bulb {
      position: absolute;
      right: 50%;
      transform: translateX(50%);
      bottom: -12%;
      top: auto;
      width: 200px;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-lg);
    }

    .operator-portrait {
      width: 240px;
      max-width: 100%;
    }
  }
</style>

