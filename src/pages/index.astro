---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClayKeycap from '../components/ClayKeycap.astro';
import '../styles/clay-feature.css';
import clayCase from '../assets/clay-diskette-case.webp';
import clayCaseTray from '../assets/clay-diskette-case-tray.webp';
import focus from '../assets/focus.webp';
import signal from '../assets/signal.webp';
import floppyDisk from '../assets/floppy-disk-note-flat-label.webp';
import floppyLabel from '../assets/floppy-label-flat-corner.webp';
import illustratedPortrait from '../assets/cw4.webp';
import photoPortrait from '../assets/cw2.webp';
---

<BaseLayout
  title="AI Tutoring & Capacity Building"
  description="Hands-on AI tutoring for individuals and teams. Build skills around your role, from everyday tasks to business applications, with Charles Wilke in Omaha."
>

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow"><span>Another tech wave. Another thing we’re supposed to know.</span></p>
        <h1 class="hero-headline glow-phosphor text-phosphor">
          LEARN BY DOING<span class="hero-cursor" aria-hidden="true">_</span>
        </h1>
        <p class="hero-tagline">Practical AI skills for your everyday work.</p>
        <p class="hero-sub">
          I offer one-to-one AI tutoring and hands-on workshops for teams.
          Learn to use AI on real tasks, from writing and research to
          building your own reusable workflows.
        </p>
        <div class="hero-cta">
          <a href="/book" class="btn btn-primary"><span class="hero-primary-label">Book a Call</span></a>
          <a href="/services" class="btn btn-ghost">Explore Tutoring &amp; Workshops</a>
        </div>
      </div>
      <div class="hero-welcome">
        <aside class="tutor-note" aria-label="A note from Charles">
          <picture class="tutor-note-surface">
            <source media="(max-width: 760px)" srcset={floppyLabel.src} type="image/webp" />
            <Image
              src={floppyDisk}
              alt=""
              class="tutor-note-disk"
              widths={[400, 640, 880, 1100]}
              sizes="(max-width: 1100px) 45vw, 480px"
              loading="eager"
            />
          </picture>
          <div class="tutor-note-copy">
            <div class="tutor-note-message">
              <p>Bring a question or something you’re working on. We’ll figure out where to start together.</p>
              <div class="tutor-note-signature">
                <span>Charles Wilke</span>
                <span>Writer // Designer // AI tutor</span>
              </div>
            </div>
            <Image
              src={illustratedPortrait}
              alt="Illustration of Charles Wilke"
              class="tutor-note-portrait"
              widths={[160, 240, 320]}
              sizes="(max-width: 760px) 102px, (max-width: 1100px) 12vw, 140px"
              loading="eager"
            />
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="clay-feature" aria-labelledby="clay-feature-title">
    <div class="container">
      <a href="/clay" class="clay-feature-panel" aria-labelledby="clay-feature-cta">
        <div class="clay-feature-copy">
          <p class="clay-feature-series">Live AI Series for Creatives</p>
          <h2 id="clay-feature-title">Throw More Clay</h2>
          <p class="clay-feature-description">Bring a creative project you care about. Spend three live evenings making it into something you stand behind.</p>
          <div class="clay-feature-action">
            <p>January 11, 18, and 25, 2027 · Online</p>
            <ClayKeycap id="clay-feature-cta">
              Explore the upcoming event <span aria-hidden="true">→</span>
            </ClayKeycap>
          </div>
        </div>
        <div class="clay-feature-art" aria-hidden="true">
          <Image
            src={clayCaseTray}
            alt=""
            class="clay-feature-tray"
            widths={[320, 480, 640]}
            sizes="(max-width: 760px) min(100vw - 4rem, 300px), (max-width: 1100px) 40vw, 420px"
            loading="lazy"
          />
          <div class="clay-feature-lid-scene">
            <Image
              src={clayCase}
              alt=""
              class="clay-feature-lid"
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 760px) min(100vw - 4rem, 300px), (max-width: 1100px) 40vw, 420px"
              loading="lazy"
            />
          </div>
          <Image
            src={clayCaseTray}
            alt=""
            class="clay-feature-hinges"
            widths={[320, 480, 640]}
            sizes="(max-width: 760px) min(100vw - 4rem, 300px), (max-width: 1100px) 40vw, 420px"
            loading="lazy"
          />
        </div>
      </a>
    </div>
  </section>

  <!-- ── What we do ── -->
  <section class="section focus-section">
    <div class="focus-bg" aria-hidden="true">
      <Image src={focus} alt="" class="focus-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container">
      <div class="focus-intro">
        <h2>Build your capacity.</h2>
        <p class="text-muted">
          Start with a question, a task, or something you want to make.
          Learn one-to-one, practice with your team, or bring the conversation
          to a room full of curious people.
        </p>
      </div>

      <div class="services-grid">
        <a href="/services#consulting" class="card service-card">
          <div class="service-icon text-phosphor">▸▸</div>
          <h3>One-to-One AI Tutoring</h3>
          <p class="text-muted">
            Bring your own work and questions. Learn to use AI, check its
            output, and build something useful at a pace that fits you.
          </p>
          <span class="card-arrow text-phosphor">→</span>
        </a>

        <a href="/services#speaking" class="card service-card">
          <div class="service-icon text-electric">▸▸</div>
          <h3>AI Speaking & Keynotes</h3>
          <p class="text-muted">
            A practical conversation about AI, human judgment, and the
            possibilities people can explore in their own work.
          </p>
          <span class="card-arrow text-electric">→</span>
        </a>

        <a href="/services#webinars" class="card service-card">
          <div class="service-icon text-amber">▸▸</div>
          <h3>Role-Focused Workshops</h3>
          <p class="text-muted">
            Build skills around the work your team knows best. Practice
            together, from everyday workflows to business applications.
          </p>
          <span class="card-arrow text-amber">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Why Fellow Vector ── -->
  <section class="section alt-section">
    <div class="container why-grid">
      <figure class="operator-portrait">
        <div class="portrait-frame">
          <Image
            src={photoPortrait}
            alt="Charles Wilke"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 240px, 320px"
            loading="lazy"
          />
          <span class="portrait-corner tl" aria-hidden="true"></span>
          <span class="portrait-corner tr" aria-hidden="true"></span>
          <span class="portrait-corner bl" aria-hidden="true"></span>
          <span class="portrait-corner br" aria-hidden="true"></span>
        </div>
        <figcaption>
          <span class="label">// the operator</span>
          <span class="portrait-name">Charles Wilke</span>
          <span class="text-muted">Writer. Designer. AI tutor.</span>
        </figcaption>
      </figure>

      <div class="why-text">
        <h2>A familiar place to begin.</h2>
        <p>
          At Toast, I design Toast IQ's top-level system instructions: the guidance
          that shapes how the AI assistant responds and acts. My perspective
          comes from working on tools people use every day.
        </p>
        <p>
          If you grew up with an Apple II, Math Blaster, or The Oregon Trail,
          this glow might feel familiar. I call it the C-prompt lifestyle:
          try something, see what happens, and learn your way forward.
          You're welcome here even if your first screen looked different.
        </p>
        <p>
          Through Fellow Vector, I bring that spirit to learning AI.
          I'm here to help people build capacity in their own roles.
          Automation should give employees more agency, more room for their
          craft, and a say in how their work changes.
        </p>
        <a href="/about" class="btn btn-ghost">More About Charles</a>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta-section">
    <div class="cta-bg" aria-hidden="true">
      <Image src={signal} alt="" class="cta-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container cta-inner">
      <h2 class="closing-cta-title text-phosphor glow-phosphor">What would you like to learn to do?</h2>
      <p class="text-muted">
        Bring a question, a recurring task, or an idea you've been meaning to try.
      </p>
      <div class="cta-buttons">
        <a href="/book" class="btn btn-primary">Book a Call</a>
        <a href="mailto:cwilke@fellowvector.com" class="btn btn-ghost">Send an Email</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section,
  .cta-section {
    padding: var(--section-space) 0;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .hero-copy {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.6rem);
    min-width: 0;
  }

  .hero-eyebrow {
    width: 100%;
    max-width: 100%;
    padding-block: 0.1rem;
    border-block: 1px solid var(--border-hover);
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .hero-eyebrow span {
    position: relative;
    top: 1px;
  }

  .hero-headline {
    font-size: clamp(1.75rem, 14cqi, 4.75rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .hero-welcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 30rem;
    min-width: 0;
    justify-self: end;
    align-self: center;
  }

  .tutor-note {
    container-type: inline-size;
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1;
    transform: rotate(-2deg);
    filter: drop-shadow(0 12px 16px rgba(12, 8, 4, 0.25));
  }

  .tutor-note-surface {
    position: absolute;
    inset: 0;
    display: block;
  }

  .tutor-note-disk {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tutor-note-copy {
    position: absolute;
    top: 13%;
    left: 10.5%;
    width: 78%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30%;
    align-items: center;
    gap: 3%;
    color: #382414;
  }

  .tutor-note-portrait {
    display: block;
    width: 100%;
    height: auto;
    transform: scale(1.15);
    mix-blend-mode: multiply;
    mask-image: radial-gradient(ellipse at center, #000 55%, transparent 76%);
  }

  .tutor-note p { font-size: clamp(0.75rem, 3.5cqi, 1rem); line-height: 1.25; }

  .tutor-note p,
  .tutor-note-signature {
    position: relative;
    top: 0.3rem;
  }

  .tutor-note-signature {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 1.1cqi;
    font-size: clamp(0.625rem, 2.6cqi, 0.75rem);
    line-height: 1.2;
    text-align: right;
    translate: 0 -0.3rem;
    color: #664a30;
  }

  .tutor-note-signature span:first-child { color: #382414; }

  @media (min-width: 761px) {
    .tutor-note p,
    .tutor-note-signature { top: calc(0.3rem - 3px); }
  }

  @media (min-width: 761px) and (max-width: 1000px) {
    .tutor-note-copy { grid-template-columns: minmax(0, 1fr) 26%; gap: 2%; }
    .tutor-note-portrait { transform: scale(1.325); }
  }

  @media (max-width: 760px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.5rem;
    }
    .hero-welcome { justify-self: center; margin-top: 0; }
    .tutor-note {
      aspect-ratio: auto;
      min-height: 13rem;
      padding: 5rem 1.5rem 3.5rem;
    }
    .tutor-note-copy {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      grid-template-columns: minmax(0, 1fr) clamp(3.5rem, calc(40cqi - 2.25rem), 5.5rem);
      gap: 0.375rem 0.5rem;
    }
    .tutor-note-message { display: contents; }
    .tutor-note p {
      grid-column: 1 / -1;
      grid-row: 1;
      font-size: clamp(0.875rem, 3.4cqi, 1rem);
      line-height: 1.35;
      text-wrap: pretty;
      top: 0.25rem;
    }
    .tutor-note-portrait {
      grid-column: 2;
      grid-row: 2;
      translate: 0 -0.25rem;
    }
    .tutor-note-signature {
      grid-column: 1;
      grid-row: 2;
      margin-top: 0;
      font-size: clamp(0.6875rem, 4.5cqi, 0.75rem);
      line-height: 1.25;
      top: 0;
      translate: none;
    }
  }

  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.6vw, 1.85rem);
    line-height: 1.2;
    color: var(--fg);
  }

  .hero-sub {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    line-height: 1.65;
    color: var(--fg-muted);
    max-width: 52ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    gap: 0.75rem;
    align-items: stretch;
  }

  .hero-cta .btn {
    --btn-inline-space: clamp(0.75rem, 1.5vw, 1.5rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    text-align: center;
    letter-spacing: 0.08em;
  }

  .hero-cta .btn-primary {
    padding-inline: calc(var(--btn-inline-space) + 0.625em);
  }

  .hero-primary-label { transition: transform 0.15s ease-out; }

  .hero-cta .btn-primary:is(:hover, :focus-visible) .hero-primary-label {
    transform: translateX(-0.625em);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-eyebrow { animation: hero-fade-in 0.7s 0.2s both; }
    .hero-headline { animation: hero-fade-in 0.7s 0.35s both; }
    .hero-tagline,
    .hero-sub { animation: hero-fade-in 0.7s 0.5s both; }
    .hero-cta { animation: hero-fade-in 0.7s 0.65s both; }
  }

  @keyframes hero-fade-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
    .tutor-note { animation: tutor-note-float 8s ease-in-out infinite; }
  }

  @keyframes tutor-note-float {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-6px) rotate(-1.5deg); }
  }

  .clay-feature {
    padding-top: calc(clamp(1.5rem, 3.5vw, 2.5rem) - 1.25rem);
  }

  .clay-feature-panel {
    --lid-open-angle: 48deg;
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: #e5bf99;
    box-shadow: 0 0.9rem 2.25rem #130c0880;
  }

  .clay-feature-panel::before,
  .clay-feature-panel::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .clay-feature-panel::before {
    inset: -6px;
    background: url('../assets/clay-wheel-texture.webp') center / cover no-repeat;
    filter: blur(1px);
  }

  .clay-feature-panel::after {
    inset: 0;
    background:
      linear-gradient(105deg, #ffe5bf99, #f6d2a55c 44%, #e5bf9933 68%);
    box-shadow: inset 0 0 0 4px #5f331b26;
  }

  .clay-feature-series {
    color: #502713;
    font-size: clamp(1rem, 1.7vw, 1.375rem);
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .clay-feature-panel:is(:hover, :focus-visible) {
    color: #2c1b10;
    text-shadow: none;
  }

  .clay-feature-panel:focus-visible {
    --lid-angle: var(--lid-open-angle);
    outline: 2px solid var(--amber);
    outline-offset: 4px;
  }

  .clay-feature-art {
    --hinge-axis: 9.4%;
    container-type: inline-size;
    position: relative;
    filter: drop-shadow(0 0.6rem 0.55rem rgba(10, 7, 4, 0.58));
  }

  .clay-feature-art img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 760px) {
    .clay-feature-panel::before { background-position: 76% center; }

    .clay-feature-panel::after {
      background: linear-gradient(#ffe5bfa6, #f6d2a570 48%, #e5bf9933 76%);
    }

    .clay-feature-art {
      width: min(100%, 300px);
      justify-self: center;
    }
  }

  .clay-feature-tray,
  .clay-feature-hinges {
    position: absolute;
    inset: 0;
  }

  .clay-feature-lid-scene {
    position: relative;
    perspective: 300cqw;
    perspective-origin: 50% var(--hinge-axis);
  }

  /* Cut the hinge barrels out of the moving lid and keep the tray's barrels in front. */
  .clay-feature-lid {
    transform: rotateX(var(--lid-angle, 0deg));
    transform-origin: 50% var(--hinge-axis);
    clip-path: polygon(
      0 var(--hinge-axis), 13% var(--hinge-axis), 13% 12.4%, 20.5% 12.4%, 20.5% var(--hinge-axis),
      80.2% var(--hinge-axis), 80.2% 12.4%, 88.1% 12.4%, 88.1% var(--hinge-axis), 100% var(--hinge-axis),
      100% 100%, 0 100%
    );
  }

  .clay-feature-hinges {
    clip-path: polygon(
      0 0, 100% 0, 100% var(--hinge-axis),
      88.1% var(--hinge-axis), 88.1% 12.4%, 80.2% 12.4%, 80.2% var(--hinge-axis),
      20.5% var(--hinge-axis), 20.5% 12.4%, 13% 12.4%, 13% var(--hinge-axis), 0 var(--hinge-axis)
    );
  }

  @media (hover: hover) {
    .clay-feature-panel:hover { --lid-angle: var(--lid-open-angle); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .clay-feature-lid {
      transition: transform 540ms cubic-bezier(0.22, 0.7, 0.25, 1);
    }
  }

  .clay-feature-action {
    display: grid;
    margin-top: var(--sp-sm);
    padding-top: 0.75rem;
    border-top: 1px solid #50271355;
    justify-items: start;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  /* ── Focus / services section ── */
  .focus-section {
    position: relative;
    overflow: hidden;
  }

  .focus-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .focus-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.08;
  }

  .focus-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(var(--bg-rgb), 0.2) 0%,
      rgba(var(--bg-rgb), 0.8) 100%
    );
  }

  .focus-section .container {
    position: relative;
    z-index: 1;
  }

  .focus-intro {
    display: grid;
    gap: var(--sp-sm);
    max-width: 35rem;
    margin-bottom: clamp(1.25rem, 3vw, var(--sp-lg));
  }

  /* ── Services grid ── */
  .services-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-md);
  }

  .service-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding: var(--sp-lg) var(--sp-lg) var(--sp-md);
  }

  .service-card h3 { color: var(--fg); transition: color 0.2s; }
  .service-card:hover h3 { color: var(--phosphor); }

  .service-icon {
    font-family: var(--font-crt);
    font-size: 1.2rem;
    letter-spacing: -0.05em;
  }

  .card-arrow {
    font-size: 1.2rem;
    margin-top: auto;
    padding-top: var(--sp-sm);
    transition: transform 0.2s;
    align-self: flex-start;
  }

  .service-card:hover .card-arrow { transform: translateX(6px); }

  @media (max-width: 959px) {
    .services-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .service-card {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr) 1.5rem;
      gap: var(--sp-sm) var(--sp-md);
      padding: 1.25rem 1.5rem;
      align-items: baseline;
    }

    .service-icon {
      grid-column: 1;
      grid-row: 1;
    }

    .service-card h3 {
      grid-column: 2;
      grid-row: 1;
    }

    .service-card p {
      grid-column: 2;
      grid-row: 2;
    }

    .card-arrow {
      grid-column: 3;
      grid-row: 1 / 3;
      margin: 0;
      padding: 0;
      align-self: center;
    }
  }

  @media (max-width: 600px) {
    .service-card {
      padding: 1.25rem;
      column-gap: 0.75rem;
    }

    .service-card p {
      grid-column: 1 / -1;
    }

    .card-arrow {
      grid-row: 1;
    }
  }

  /* ── Why / alt section ── */
  .alt-section {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--sp-xl);
    align-items: center;
  }

  .why-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .why-text .btn {
