---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import splash from '../assets/splash.webp';
import focus from '../assets/focus.webp';
import signal from '../assets/signal.webp';
import bulb from '../assets/bulb.webp';
import portrait from '../assets/cw4.webp';
---

<BaseLayout
  title="AI Consulting & Team Training"
  description="Practical AI consulting, workflow design, and team training for small and mid-sized businesses. Work directly with Charles Wilke, based in Omaha."
>

  <!-- ── Hero ── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-label label">// incoming transmission</div>
      <h1 class="hero-headline glow-green text-phosphor">
        NAVIGATE<br />THE SIGNAL<span class="hero-cursor">_</span>
      </h1>
      <p class="hero-sub">
        Practical AI consulting and training for small and mid-sized businesses.
        Less guesswork. More time for the work you care about.
      </p>
      <div class="hero-cta">
        <a href="/services" class="btn btn-primary">Explore AI Services</a>
        <a href="/book" class="btn btn-ghost">Book a Call</a>
      </div>
    </div>

    <div class="hero-bg" aria-hidden="true">
      <Image
        src={splash}
        alt=""
        class="hero-splash"
        widths={[480, 800, 1200, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- ── Signal strip ── -->
  <!-- 4 copies so seam is always off-screen; animation travels -25% = exactly one copy width -->
  <div class="signal-strip" aria-hidden="true">
    <div class="signal-ticker">
      <span>CONSULTING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>WEBINARS</span><span class="sep">///</span><span>STRATEGY</span><span class="sep">///</span><span>AI ADOPTION</span><span class="sep">///</span><span>LEADERSHIP</span><span class="sep">///</span>
      <span>CONSULTING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>WEBINARS</span><span class="sep">///</span><span>STRATEGY</span><span class="sep">///</span><span>AI ADOPTION</span><span class="sep">///</span><span>LEADERSHIP</span><span class="sep">///</span>
      <span>CONSULTING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>WEBINARS</span><span class="sep">///</span><span>STRATEGY</span><span class="sep">///</span><span>AI ADOPTION</span><span class="sep">///</span><span>LEADERSHIP</span><span class="sep">///</span>
      <span>CONSULTING</span><span class="sep">///</span><span>SPEAKING</span><span class="sep">///</span><span>WEBINARS</span><span class="sep">///</span><span>STRATEGY</span><span class="sep">///</span><span>AI ADOPTION</span><span class="sep">///</span><span>LEADERSHIP</span><span class="sep">///</span>
    </div>
  </div>

  <!-- ── What we do ── -->
  <section class="section focus-section">
    <div class="focus-bg" aria-hidden="true">
      <Image src={focus} alt="" class="focus-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="container">
      <div class="section-head">
        <div class="label">// services offered</div>
        <h2>Put AI to work.</h2>
        <p class="text-muted">
          A plan for where to start. Practice with your team's real tasks.
          A talk that makes the next step clearer. Pick the channel.
        </p>
      </div>

      <div class="services-grid">
        <a href="/services#consulting" class="card service-card">
          <div class="service-icon text-phosphor">▸▸</div>
          <h3>AI Strategy & Consulting</h3>
          <p class="text-muted">
            Find where AI can help, choose tools that fit, and build a plan
            your team can put to use.
          </p>
          <span class="card-arrow text-phosphor">→</span>
        </a>

        <a href="/services#speaking" class="card service-card">
          <div class="service-icon text-electric">▸▸</div>
          <h3>AI Speaking & Keynotes</h3>
          <p class="text-muted">
            Talks on AI, human judgment, and meaningful work, grounded in
            practice and shaped around your audience's decisions.
          </p>
          <span class="card-arrow text-electric">→</span>
        </a>

        <a href="/services#webinars" class="card service-card">
          <div class="service-icon text-amber">▸▸</div>
          <h3>AI Training & Workshops</h3>
          <p class="text-muted">
            Practice giving clear instructions, checking results, and
            building useful workflows with the tasks your team already does.
          </p>
          <span class="card-arrow text-amber">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Why Fellow Vector ── -->
  <section class="section alt-section">
    <div class="container why-grid">
      <figure class="operator-portrait">
        <div class="portrait-frame">
          <Image
            src={portrait}
            alt="Illustrated portrait of Charles Wilke"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 240px, 320px"
            loading="lazy"
          />
          <span class="portrait-corner tl" aria-hidden="true"></span>
          <span class="portrait-corner tr" aria-hidden="true"></span>
          <span class="portrait-corner bl" aria-hidden="true"></span>
          <span class="portrait-corner br" aria-hidden="true"></span>
        </div>
        <figcaption>
          <span class="label">// the operator</span>
          <span class="portrait-name">Charles Wilke</span>
          <span class="text-muted">Writer. Designer. AI consultant.</span>
        </figcaption>
      </figure>

      <div class="why-text">
        <div class="label">// the frequency</div>
        <h2>Signal over noise.</h2>
        <p>
          At Toast, I design Toast IQ's top-level system instructions: the guidance
          that shapes how the AI assistant responds and acts. My perspective
          comes from working on tools people use every day.
        </p>
        <p>
          Through Fellow Vector, you work with me directly. We look at your tasks
          and tools, decide what to try, and check whether it's helping.
          Your team's judgment stays in the loop.
        </p>
        <p>
          The goal is more room for your craft, your people, and the work
          that keeps getting crowded out.
        </p>
        <a href="/about" class="btn btn-ghost">More About Charles</a>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta-section">
    <div class="cta-bg" aria-hidden="true">
      <Image src={signal} alt="" class="cta-splash" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="cta-bulb" aria-hidden="true">
      <Image src={bulb} alt="" widths={[400, 640]} sizes="(max-width: 768px) 200px, 320px" loading="lazy" />
    </div>
    <div class="container cta-inner">
      <h2 class="text-phosphor glow-green">What would you like more time for?</h2>
      <p class="text-muted">
        Let's talk about what's taking up your day and where AI could help.
      </p>
      <div class="cta-buttons">
        <a href="/book" class="btn btn-primary">Book a Call</a>
        <a href="mailto:cwilke@fellowvector.com" class="btn btn-ghost">Send an Email</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section,
  .cta-section {
    padding: clamp(3rem, 6vw, var(--sp-xl)) 0;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: calc(100vh - 64px);
    min-height: calc(100svh - 64px); /* mobile: don't overshoot the visible area under the toolbar */
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    opacity: 0.55;
  }

  /* Gradient: dark on the left where text lives, fades toward image on the right */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right,
        var(--bg) 20%,
        rgba(8, 9, 15, 0.75) 50%,
        rgba(8, 9, 15, 0.2) 100%
      ),
      linear-gradient(to top,
        var(--bg) 0%,
        transparent 30%
      );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
    padding-top: var(--sp-2xl);
    padding-bottom: var(--sp-2xl);
  }

  .hero-label { animation: fadeIn 0.6s 0.2s both; }
  .hero-headline { animation: fadeIn 0.7s 0.35s both; line-height: 1; }

  .hero-cursor {
    display: inline-block;
    margin-left: 0.05em;
    animation: blink 4.2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .hero-sub {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    color: var(--fg-muted);
    max-width: 52ch;
    animation: fadeIn 0.7s 0.5s both;
  }
  .hero-cta {
    display: flex;
    gap: var(--sp-md);
    flex-wrap: wrap;
    animation: fadeIn 0.7s 0.65s both;
  }

  /* ── Signal strip ── */
  .signal-strip {
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.6rem 0;
    background: var(--bg-surface);
  }

  .signal-ticker {
    display: flex;
    gap: 2rem;
    white-space: nowrap;
    animation: ticker 22s linear infinite;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--fg-muted);
    width: max-content;
    will-change: transform;
    backface-visibility: hidden;
  }

  .signal-ticker .sep {
    color: var(--phosphor-dim);
    opacity: 0.5;
  }

  @keyframes ticker {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-25%, 0, 0); }
  }

  /* ── Focus / services section ── */
  .focus-section {
    position: relative;
    overflow: hidden;
  }

  .focus-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .focus-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.18;
  }

  .focus-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(8, 9, 15, 0.2) 0%,
      rgba(8, 9, 15, 0.8) 100%
    );
  }

  .focus-section .container {
    position: relative;
    z-index: 1;
  }

  /* ── Services grid ── */
  .section-head {
    margin-bottom: var(--sp-lg);
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .section-head h2 { margin-top: var(--sp-xs); }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-md);
  }

  .service-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    padding: var(--sp-lg) var(--sp-lg) var(--sp-md);
  }

  .service-card h3 { color: var(--fg); transition: color 0.2s; }
  .service-card:hover h3 { color: var(--phosphor); }

  .service-icon {
    font-family: var(--font-crt);
    font-size: 1.2rem;
    letter-spacing: -0.05em;
  }

  .card-arrow {
    font-size: 1.2rem;
    margin-top: auto;
    padding-top: var(--sp-sm);
    transition: transform 0.2s;
    align-self: flex-start;
  }

  .service-card:hover .card-arrow { transform: translateX(6px); }

  @media (max-width: 959px) {
    .services-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .service-card {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr) 1.5rem;
      gap: var(--sp-sm) var(--sp-md);
      padding: 1.25rem 1.5rem;
      align-items: baseline;
    }

    .service-icon {
      grid-column: 1;
      grid-row: 1;
    }

    .service-card h3 {
      grid-column: 2;
      grid-row: 1;
    }

    .service-card p {
      grid-column: 2;
      grid-row: 2;
    }

    .card-arrow {
      grid-column: 3;
      grid-row: 1 / 3;
      margin: 0;
      padding: 0;
      align-self: center;
    }
  }

  @media (max-width: 600px) {
    .service-card {
      padding: 1.25rem;
      column-gap: 0.75rem;
    }

    .service-card p {
      grid-column: 1 / -1;
    }

    .card-arrow {
      grid-row: 1;
    }
  }

  /* ── Why / alt section ── */
  .alt-section {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--sp-xl);
    align-items: center;
  }

  .why-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .why-text .btn {
    align-self: flex-start;
    margin-top: var(--sp-sm);
  }

  .operator-portrait {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .portrait-frame {
    position: relative;
    border: 1px solid var(--phosphor-dim);
    padding: var(--sp-sm);
    background: var(--bg);
  }

  .portrait-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .portrait-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--phosphor);
    border-style: solid;
    border-width: 0;
  }

  .portrait-corner.tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
  .portrait-corner.tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
  .portrait-corner.bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
  .portrait-corner.br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

  .operator-portrait figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    font-size: 0.85rem;
  }

  .portrait-name {
    font-family: var(--font-crt);
    font-size: 1.8rem;
    line-height: 1.15;
    letter-spacing: 0.04em;
  }

  /* ── CTA ── */
  .cta-section {
    position: relative;
    text-align: center;
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-splash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.12;
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(8, 9, 15, 0.3) 0%,
      rgba(8, 9, 15, 0.85) 100%
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-lg);
    max-width: 60%;
    margin: 0 auto;
  }

  .cta-bulb {
    position: absolute;
    right: 5%;
    bottom: -15%;
    top: auto;
    transform: none;
    width: 320px;
    mix-blend-mode: screen;
  }

  .cta-bulb img {
    width: 100%;
    height: auto;
    display: block;
  }

  .cta-buttons {
    display: flex;
    gap: var(--sp-md);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .cta-inner {
      max-width: 100%;
      align-items: center;
      text-align: center;
    }

    .cta-buttons {
      justify-content: center;
    }

    .cta-bulb {
      position: absolute;
      right: 50%;
      transform: translateX(50%);
      bottom: -12%;
      top: auto;
      width: 200px;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-lg);
    }

    .operator-portrait {
      width: 240px;
      max-width: 100%;
    }
  }
</style>

