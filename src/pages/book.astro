---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import bookHero from '../assets/book.webp';
---

<BaseLayout
  title="Book a Call"
  description="Talk with Charles Wilke about what you want to learn. Start with a 30-minute conversation about AI tutoring, a role-focused workshop, or a talk."
>
  <!-- The booking embed is this page's main content; open the connections before its script asks -->
  <link slot="head" rel="preconnect" href="https://app.cal.com" />
  <link slot="head" rel="preconnect" href="https://cal.com" />

  <PageHero label="// establish connection" title="Book a Call" image={bookHero} imageOpacity={0.45}>
    <p class="text-muted page-hero-sub">
      Bring <span class="shimmer shimmer-1" data-text="your questions">your questions</span>.<br />
      Start with <span class="shimmer shimmer-2" data-text="your work">your work</span>.<br />
      Make room to <span class="shimmer shimmer-3" data-text="learn by doing">learn by doing</span>.
    </p>
  </PageHero>

  <section class="section">
    <div class="container booking-layout">

      <div class="booking-sidebar">
        <div class="booking-info-block">
          <div class="label">// what to expect</div>
          <p>
            A 30-minute exploratory call. No pitch, no pressure. We'll talk about
            what you want to learn, your experience so far, and a task or idea you'd
            like to explore. Together, we'll find a sensible place to start.
          </p>
        </div>

        <div class="booking-info-block">
          <div class="label">// prefer email?</div>
          <a href="mailto:cwilke@fellowvector.com" class="email-link">cwilke@fellowvector.com</a>
        </div>

        <div class="booking-info-block">
          <div class="label">// good fits</div>
          <ul class="info-list">
            <li>You want a patient guide while you learn to use AI</li>
            <li>You want to build a workflow or application and understand how it works</li>
            <li>Your team wants hands-on practice built around a specific role</li>
            <li>You're looking for a talk that gives people a useful starting point</li>
          </ul>
        </div>
      </div>

      <!-- ── Cal.com embed ── -->
      <div class="booking-embed-wrap">
        <div class="embed-frame">
          <div class="embed-corner tl"></div>
          <div class="embed-corner tr"></div>
          <div class="embed-corner bl"></div>
          <div class="embed-corner br"></div>
          <div class="embed-scanlines" aria-hidden="true"></div>
          <div id="cal-embed"></div>
        </div>
      </div>

    </div>
  </section>

  <script type="text/javascript">
    (function (C, A, L) {
      let p = function (a, ar) { a.q.push(ar); };
      let d = C.document;
      C.Cal = C.Cal || function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () { p(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ["initNamespace", namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
    })(window, "https://app.cal.com/embed/embed.js", "init");

    Cal("init", { origin: "https://cal.com" });

    Cal("inline", {
      elementOrSelector: "#cal-embed",
      calLink: "cwilke/discovery-call",
      config: {
        layout: "month_view",
        theme: "dark",
        brandColor: "#ffbd59",
      }
    });

    // Remove scrollbar from Cal.com iframe once it's injected
    const observer = new MutationObserver(() => {
      const iframe = document.querySelector("#cal-embed iframe");
      if (iframe) {
        iframe.setAttribute("scrolling", "no");
        observer.disconnect();
      }
    });
    observer.observe(document.getElementById("cal-embed"), { childList: true, subtree: true });
  </script>
</BaseLayout>

<style>
  .page-hero-sub {
    font-size: 1rem;
    max-width: 52ch;
  }

  .booking-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--layout-gap);
    align-items: start;
  }

  .booking-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
    position: sticky;
    top: calc(var(--nav-height) + 16px);
  }

  .booking-info-block {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .booking-info-block p {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  .email-link {
    font-size: 0.85rem;
    color: var(--phosphor);
    letter-spacing: 0.04em;
    transition: opacity 0.2s;
  }

  .email-link:hover { opacity: 0.7; }

  .info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
  }

  .info-list li {
    position: relative;
    font-size: 0.85rem;
    color: var(--fg-muted);
    padding-left: var(--sp-md);
    border-left: 1px solid var(--border);
    line-height: 1.5;
  }

  @media (hover: hover) {
    .info-list li::before {
      content: '';
      position: absolute;
      inset: 0 auto 0 -1px;
      width: 1px;
      background: var(--phosphor);
      box-shadow: var(--glow-phosphor);
      opacity: 0;
      pointer-events: none;
    }

    .info-list li:hover::before { opacity: 1; }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .info-list li::before { transition: opacity 180ms ease-out; }
  }

  /* Embed area */
  .booking-embed-wrap {
    min-height: 600px;
  }

  .embed-frame {
    position: relative;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    overflow: hidden;
  }

  /* Corner brackets */
  .embed-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    z-index: 2;
    pointer-events: none;
  }

  .embed-corner.tl { top: -1px; left: -1px; border-top: 2px solid var(--phosphor); border-left: 2px solid var(--phosphor); }
  .embed-corner.tr { top: -1px; right: -1px; border-top: 2px solid var(--phosphor); border-right: 2px solid var(--phosphor); }
  .embed-corner.bl { bottom: -1px; left: -1px; border-bottom: 2px solid var(--phosphor); border-left: 2px solid var(--phosphor); }
  .embed-corner.br { bottom: -1px; right: -1px; border-bottom: 2px solid var(--phosphor); border-right: 2px solid var(--phosphor); }

  /* Scanline overlay */
  .embed-scanlines {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 3px,
      rgba(0, 0, 0, 0.08) 3px,
      rgba(0, 0, 0, 0.08) 4px
    );
  }

  #cal-embed {
    position: relative;
    width: 100%;
    min-height: 600px;
  }

  @media (max-width: 1023px) {
    .booking-layout {
      grid-template-columns: 1fr;
      gap: var(--sp-lg);
    }

    .booking-sidebar {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-lg);
    }

    .booking-info-block:last-child {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }

  @media (max-width: 640px) {
    .booking-sidebar {
      grid-template-columns: minmax(0, 1fr);
    }

    .booking-info-block:last-child {
      grid-column: auto;
      grid-row: auto;
    }
  }

  /* The glow lives on a pseudo-element so the loop only animates opacity
     (compositor-only) instead of repainting text-shadow every frame. */
  .shimmer {
    display: inline-block;
    position: relative;
    white-space: nowrap;
    color: var(--phosphor);
    opacity: 0.6;
    animation: shimmer 6s ease-in-out infinite;
  }

  .shimmer::after {
    content: attr(data-text) / "";
    position: absolute;
    inset: 0;
    color: transparent;
    text-shadow: 0 0 8px var(--phosphor), 0 0 16px rgba(255, 189, 89, 0.3);
    opacity: 0;
    animation: shimmer-glow 6s ease-in-out infinite;
    animation-delay: inherit;
    pointer-events: none;
  }

  .shimmer-1 { animation-delay: 0s; }
  .shimmer-2 { animation-delay: 2s; }
  .shimmer-3 { animation-delay: 4s; }

  @keyframes shimmer {
    0%, 100% { opacity: 0.6; }
    50%      { opacity: 1; }
  }

  @keyframes shimmer-glow {
    0%, 100% { opacity: 0; }
    50%      { opacity: 1; }
  }
</style>
