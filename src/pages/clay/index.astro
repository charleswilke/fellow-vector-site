---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import artRoomHero from '../../assets/clay-art-room.webp';
import foundingPriceInk from '../../assets/clay-founding-price-ink.webp';
import spectatorPoster from '../../assets/clay-spectator-poster.webp';
import portrait from '../../assets/cw2.webp';
import { clayEvenings } from '../../data/clay-evenings';

// Sales aren't open yet, so every "save your seat" action points to the interest list.
const signupHref = '/clay/interest';

const takeaways = [
  { k: 'Point of view', v: 'Your point of view, on one page.' },
  { k: 'The piece', v: 'A piece you directed and stand behind.' },
  { k: "Author's note", v: "An author's note that shows your work." },
  { k: 'Tool plan', v: 'A plan for the tools you keep.' },
  { k: "What's next", v: 'Your next project, and a partner to see it through.' },
];

const faqs = [
  { q: 'Do I need to know AI tools?', a: "No. If you can open a browser and a chat window, you're ready." },
  { q: 'Do I need paid AI subscriptions?', a: 'No. Free versions work for every exercise.' },
  { q: 'What if I miss an evening?', a: 'Each main session is recorded and shared with the group the next day. Breakout rooms stay private.' },
  { q: 'Are you going to tell me to use AI for everything?', a: 'No. Some people leave using less. That counts.' },
  { q: 'What happens to the work I share?', a: 'It stays yours. Nothing from the group goes into anything I publish without asking you first.' },
  { q: 'Can my team do this together?', a: "Yes, as a private workshop. Book a call and we'll shape it to your work." },
  { q: 'What if I need to cancel?', a: 'Full refund up to a week before Evening 1. After that, your seat moves to the next cohort.' },
];
---

<BaseLayout
  title="Throw More Clay"
  description="Three live evenings for creatives making their way in the AI era. Bring one project, leave with a piece you directed and a point of view you can name. 12 seats, January 2027."
>
  <PageHero
    label="04 // small-group series for creatives"
    title="THROW MORE CLAY"
    showCursor
    image={artRoomHero}
    imageOpacity={0.77}
    imagePosition="74% 48%"
    preserveImageColor
    wideFraming
    compact
  >
    <p class="page-hero-sub clay-sub">Three live evenings working creatively with AI. Bring one project. Leave with a piece you directed.</p>
    <dl class="clay-spec" aria-label="Series details">
      <div><dt>Mondays · 2027</dt><dd>Jan 11 · 18 · 25</dd></div>
      <div><dt>Live online</dt><dd>6–8 pm Central</dd></div>
      <div><dt>Room</dt><dd>12 seats</dd></div>
      <div><dt>Founding price</dt><dd>$295</dd></div>
    </dl>
    <div class="clay-actions">
      <a href={signupHref} class="btn btn-primary btn-lg">Join the Interest List</a>
      <nav class="clay-jumps" aria-label="On this page">
        <a href="#clay-evenings">Schedule <span aria-hidden="true">↓</span></a>
        <a href="#clay-details">Details <span aria-hidden="true">↓</span></a>
      </nav>
    </div>
    <p class="clay-status"><span class="clay-led" aria-hidden="true"></span>Seats open soon. The list hears first.</p>
  </PageHero>

  <div class="section clay-program">
    <div class="container clay-program-grid">
      <section class="clay-intro clay-stack" aria-labelledby="clay-why">
        <div class="clay-heading">
          <div class="label">// why this exists</div>
          <h2 id="clay-why" class="clay-lead">Great work still takes <em>your judgement.</em></h2>
        </div>
        <p>Another round of outsourcing and automation. Another round of folks telling you your craft is cheap.</p>
        <p>
          This is a small live series for designers, writers, musicians, illustrators,
          and theater and video makers. Curious, anxious or skeptical. All welcome.
        </p>
        <p>You bring one project you care about. We spend three evenings making it real.</p>
        <p class="text-muted">
          No coding. No hype. No rerolling until something looks fine. You direct. You
          revise. You put your name on it. Then you say how it was made.
        </p>
      </section>
      <div class="clay-program-sidebar clay-stack">
        <section class="clay-stack clay-stack-sm" aria-labelledby="clay-host-title">
          <div class="label">// who's running it</div>
          <div class="clay-host">
            <Image
              src={portrait}
              alt="Charles Wilke, smiling in round glasses in his studio."
              widths={[108, 144, 160, 216, 288, 320]}
              sizes="(max-width: 760px) clamp(130px, 38vw, 160px), (max-width: 900px) 108px, (max-width: 1200px) 12vw, 144px"
              loading="lazy"
            />
            <div class="clay-stack clay-stack-sm">
              <h2 id="clay-host-title">Charles Wilke</h2>
              <p>
                Twenty years in TV, print, radio, games and marketing. Now I design how
                conversational AI talks, for a living. I make things with AI in public,
                and I say how.
              </p>
            </div>
          </div>
        </section>

        <section id="clay-evenings" class="clay-schedule clay-stack" aria-labelledby="clay-program-title">
          <div class="clay-heading">
            <div class="label">// the schedule</div>
            <h2 id="clay-program-title">The three evenings</h2>
          </div>
          <div class="clay-agenda">
            {clayEvenings.map((ev, index) => (
              <details class="clay-evening-details">
                <summary>
                  <span class="clay-evening-meta">
                    <span class="label">Evening {index + 1}</span>
                    <time datetime={ev.date}>{ev.day}</time>
                  </span>
                  <span class="clay-evening-preview">
                    <span class="clay-evening-title">{ev.title}</span>
                    <span class="clay-outcome">{ev.outcome}</span>
                  </span>
                </summary>
                <div class="clay-evening-body clay-stack clay-stack-sm">
                  <p>{ev.body}</p>
                  {ev.homework && <p class="clay-homework">{ev.homework}</p>}
                </div>
              </details>
            ))}
          </div>
        </section>

        <section id="clay-details" class="clay-receipt" aria-labelledby="clay-details-title">
          <div class="clay-paper">
            <h2 id="clay-details-title" class="clay-receipt-title">The details</h2>
            <dl>
              <dt>When</dt><dd>Mondays, January 11, 18 and 25, 2027</dd>
              <dt>Time</dt><dd>6 to 8 pm Central, live online</dd>
              <dt>Between</dt><dd>1 to 2 hours of making at home</dd>
              <dt>Room</dt><dd>12 seats</dd>
              <dt>Price</dt>
              <dd class="clay-receipt-price">
                <del class="clay-was">$395</del>
                <Image
                  src={foundingPriceInk}
                  alt="$295, founding cohort price"
                  class="clay-price-ink"
                  widths={[208, 416, 624]}
                  sizes="208px"
                />
              </dd>
              <dt>Missed one?</dt><dd>Main sessions are recorded. Breakout rooms stay private.</dd>
            </dl>
          </div>
          <div class="clay-receipt-signup clay-stack clay-stack-sm">
            <a href={signupHref} class="btn btn-primary">Join the Interest List</a>
            <p class="text-muted clay-small">You’ll hear first when seats open.</p>
            <p class="text-muted clay-small">Not sure it's for you? <a href="/book">Book a 30-minute call.</a></p>
          </div>
        </section>
        <a class="clay-talk" href="https://charleswilke.com/s2i" aria-labelledby="clay-talk-title clay-talk-link">
          <Image src={spectatorPoster} alt="" widths={[120, 240, 360]} sizes="120px" loading="lazy" />
          <div class="clay-talk-copy clay-stack clay-stack-sm">
            <h2 id="clay-talk-title">Spectator to Initiator</h2>
            <p>My previous OMA × AI talk on going from watching what AI can do to deciding what to make with it.</p>
            <span id="clay-talk-link">View the slide deck <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      </div>
      <section class="clay-program-takeaways clay-stack clay-stack-sm" aria-labelledby="clay-takeaways-title">
        <h2 id="clay-takeaways-title">What you’ll leave with</h2>
        <ul class="clay-takeaways">
          {takeaways.map((t) => (
            <li><span class="label">{t.k}</span><p>{t.v}</p></li>
          ))}
        </ul>
        <p class="text-muted clay-small">
          Need it for your team instead? I run this as a private workshop too.
          <a href="/book">Book a call</a> and we'll shape it to your work.
        </p>
        <section class="clay-program-faq clay-stack clay-stack-sm" aria-labelledby="clay-faq">
          <h3 id="clay-faq">FAQ</h3>
          <div class="clay-faq">
            {faqs.map((f) => (
              <details><summary>{f.q}</summary><p>{f.a}</p></details>
            ))}
          </div>
        </section>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .clay-sub {
    max-width: 54ch;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.5;
  }

  .clay-spec {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 1px;
    width: fit-content;
    max-width: 100%;
    margin-top: var(--sp-sm);
    background: var(--border);
    border: 1px solid var(--border);
  }

  .clay-spec div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    padding: 0.55rem 0.75rem;
    background: rgba(var(--bg-rgb), 0.85);
  }

  .clay-spec dt {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .clay-spec dd {
    font-family: var(--font-crt);
    font-size: clamp(1.25rem, 2.4vw, 1.55rem);
    line-height: 1.1;
    color: var(--electric);
    font-variant-numeric: tabular-nums;
  }

  .clay-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs) var(--sp-lg);
    align-items: center;
    margin-top: var(--sp-sm);
  }

  .clay-actions .btn { padding-block: 0.8rem; }

  .clay-jumps { display: flex; flex-wrap: wrap; gap: var(--sp-lg); }

  .clay-jumps a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-sm);
    min-height: 44px;
    color: var(--electric);
    text-underline-offset: 0.25em;
  }

  .clay-jumps span { color: var(--phosphor); }
  .clay-jumps a:is(:hover, :focus-visible) { text-decoration: underline; }

  .clay-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--sp-xs);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--electric);
  }

  .clay-led {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--phosphor);
    box-shadow: var(--glow-phosphor);
    animation: clay-pulse 2.4s ease-in-out infinite;
  }

  @keyframes clay-pulse { 50% { opacity: 0.35; } }

  .clay-stack { display: flex; flex-direction: column; gap: var(--sp-md); min-width: 0; }
  .clay-stack-sm { gap: var(--sp-sm); }
  .clay-heading { display: flex; flex-direction: column; gap: var(--sp-xs); }

  .clay-lead {
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    text-wrap: pretty;
  }

  .clay-lead em {
    display: inline-block;
    font-style: normal;
    color: var(--phosphor);
    text-shadow: var(--glow-phosphor);
  }

  .clay-program { padding-block: clamp(1.5rem, 2.5vw, 2rem) var(--section-space); }

  .clay-program-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: var(--sp-lg) clamp(2rem, 5vw, 4.5rem);
  }

  .clay-intro p { max-width: 53ch; }
  .clay-program-sidebar { grid-column: 2; grid-row: 1 / span 2; gap: var(--sp-lg); }
  .clay-schedule h2 { font-size: clamp(2rem, 3vw, 2.65rem); }
  .clay-program-takeaways h2 { font-size: clamp(1.65rem, 2.5vw, 2rem); }
  .clay-program-takeaways > p { margin-top: var(--sp-sm); }

  .clay-agenda {
    border: 1px solid var(--border-hover);
    border-top-color: var(--phosphor-dim);
    background: rgba(var(--bg-rgb), 0.65);
  }

  .clay-evening-meta, .clay-evening-preview {
    display: grid;
    justify-items: start;
    gap: var(--sp-xs);
  }

  .clay-evening-meta .label {
    color: var(--fg-muted);
    font-size: 0.62rem;
    white-space: nowrap;
  }

  .clay-evening-meta time {
    padding: 0.1rem 0.4rem;
    background: #efe3c8;
    color: #2b2218;
    font-size: 0.85rem;
    line-height: 1.5;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .clay-evening-title {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.1vw, 1.8rem);
    line-height: 1.08;
  }

  .clay-outcome {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .clay-evening-details { --agenda-inset: clamp(0.75rem, 1.5vw, 1.15rem); }

  .clay-evening-details + .clay-evening-details {
    border-top: 1px solid var(--border);
  }

  .clay-evening-details summary {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) 0.9rem;
    align-items: center;
    gap: clamp(0.65rem, 1.25vw, 1rem);
    padding: 0.7rem var(--agenda-inset);
    cursor: pointer;
    list-style: none;
  }

  .clay-evening-details summary::-webkit-details-marker { display: none; }
  .clay-evening-details summary::after {
    content: '+' / '';
    color: var(--phosphor);
    font: 1.4rem / 1 var(--font-crt);
  }
  .clay-evening-details[open] summary::after { content: '−' / ''; }
  .clay-evening-details summary:hover { background: var(--bg-raised); }
  .clay-evening-details summary:focus-visible { outline: 2px solid var(--electric); outline-offset: -2px; }

  .clay-evening-body {
    padding: var(--sp-xs) var(--agenda-inset) var(--sp-md);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .clay-homework {
    padding-left: 0.8rem;
    border-left: 2px solid var(--amber);
    font-size: 0.88rem;
    color: var(--electric);
  }

  .clay-takeaways {
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .clay-takeaways li {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 2fr;
    align-items: baseline;
    gap: var(--sp-sm);
    padding-block: 0.55rem;
    border-top: 1px solid var(--border);
  }

  .clay-takeaways p { font-size: 0.95rem; line-height: 1.5; }

  .clay-receipt {
    container-type: inline-size;
    max-width: 30rem;
  }

  .clay-receipt-signup {
    align-items: center;
    margin-top: var(--sp-md);
    text-align: center;
  }

  .clay-talk {
    display: grid;
    grid-template-columns: clamp(88px, 27%, 120px) minmax(0, 15rem);
    justify-content: center;
    align-self: center;
    gap: var(--sp-md);
    width: 100%;
    max-width: 30rem;
    padding-block: var(--sp-md);
    border-block: 1px solid var(--border);
    text-shadow: none;
  }

  .clay-talk img { display: block; align-self: start; width: 100%; height: auto; }
  .clay-talk h2 { font-size: clamp(1.5rem, 2.5vw, 1.9rem); color: var(--fg); text-wrap: wrap; }
  .clay-talk-copy p { max-width: 28ch; font-size: 0.85rem; line-height: 1.45; color: var(--fg-muted); }
  .clay-talk #clay-talk-link { margin-top: auto; font-size: 0.85rem; line-height: 1.45; }
  .clay-talk:is(:hover, :focus-visible) { border-color: var(--border-hover); text-shadow: none; }
  .clay-talk:is(:hover, :focus-visible) #clay-talk-link { text-decoration: underline; }

  .clay-paper {
    /* Match the header and torn edge to the 2:3 source image; only the blank middle stretches. */
    --receipt-header: 28.5cqw;
    --receipt-footer: 6cqw;
    position: relative;
    isolation: isolate;
    padding: var(--receipt-header) 9cqw var(--receipt-footer);
    color: #2b2218;
  }

  .clay-paper::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(#efe3c8, #efe3c8) center / 90% 95% no-repeat;
    border-image: url('../../assets/clay-details-receipt.webp') 19% 0 4% fill stretch;
    border-image-width: var(--receipt-header) 0 var(--receipt-footer);
  }

  .clay-receipt-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .clay-paper dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.55rem clamp(0.75rem, 4cqw, 1.2rem);
    padding-block: var(--sp-sm) var(--sp-md);
    border-block: 1px dashed #a28c6c;
  }

  .clay-paper dt {
    padding-top: 0.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6b5636;
  }

  .clay-paper dd { line-height: 1.5; }
  .clay-receipt-price {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--sp-sm);
  }

  .clay-was {
    position: relative;
    text-decoration: none;
  }

  .clay-was::after {
    content: '';
    position: absolute;
    inset: 50% -0.16em auto;
    height: 1.5px;
    background: #194a88;
    border-radius: 70% 30% 60% 40%;
    transform: rotate(-7deg);
  }

  .clay-price-ink {
    width: min(100%, 13rem);
    height: auto;
    margin-top: -0.875rem;
  }

  .clay-host {
    --portrait-size: clamp(108px, 12vw, 144px);
    --portrait-cut: 10px;
    --portrait-shape: polygon(var(--portrait-cut) 0, 100% 0, calc(100% - var(--portrait-cut)) 100%, 0 100%);
    display: grid;
    grid-template-columns: var(--portrait-size) minmax(0, 1fr);
    gap: var(--sp-md);
    align-items: start;
  }

  .clay-host h2 { font-size: clamp(1.65rem, 2.5vw, 2rem); }
  .clay-host p { font-size: 0.95rem; line-height: 1.5; }

  .clay-host img {
    width: var(--portrait-size);
    height: var(--portrait-size);
    object-fit: cover;
    border: 1px solid var(--border-hover);
    clip-path: var(--portrait-shape);
  }

  .clay-small { font-size: 0.85rem; }

  .clay-program-faq { margin-top: var(--sp-md); }
  .clay-faq { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .clay-faq details { border-bottom: 1px solid var(--border); }

  .clay-faq summary {
    position: relative;
    padding: 1rem 2.2rem 1rem 0;
    cursor: pointer;
    list-style: none;
  }

  .clay-faq summary::-webkit-details-marker { display: none; }

  .clay-faq summary::after {
    content: '+';
    position: absolute;
    right: 0.4rem;
    top: 0.85rem;
    font-family: var(--font-crt);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--phosphor);
  }

  .clay-faq details[open] summary::after { content: '\2212'; }
  .clay-faq summary:hover { color: var(--electric); }
  .clay-faq details p { padding-bottom: 1.1rem; color: var(--fg-muted); }

  @media (max-width: 760px) {
    .clay-program-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
    }
    .clay-program-sidebar { grid-column: auto; grid-row: auto; }

    .clay-host {
      --portrait-size: clamp(130px, 38vw, 160px);
      --portrait-cut: 16px;
      display: flow-root;
    }

    .clay-host img {
      float: left;
      margin: 0 var(--sp-md) var(--sp-xs) 0;
      shape-outside: var(--portrait-shape) border-box;
      shape-margin: 0.75rem;
    }

    .clay-host .clay-stack { display: block; }
    .clay-host h2 { margin-bottom: var(--sp-sm); }
  }

  @media (max-width: 600px) {
    .clay-spec { grid-template-columns: repeat(2, auto); }
    .clay-actions { column-gap: var(--sp-md); }
    .clay-actions .btn { --btn-inline-space: 1.5rem; font-size: 0.9rem; }
  }

  @media (max-width: 520px) {
    .clay-takeaways li { grid-template-columns: minmax(6rem, 1fr) 2fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .clay-led { animation: none; }
  }
</style>
